# The first room: a grid floor of 1-metre squares under a soft, even light, so a
# new project opens on something you can see and judge sizes by.
title "New Project"
sky "color", color: rgb(0.62, 0.64, 0.68)
ground 60, material: material("grey", color: rgb(0.62, 0.63, 0.65), roughness: 0.9, pattern: "grid", pattern_color: rgb(0.16, 0.16, 0.17), pattern_scale: 1)
camera at: vec(0, 1.6, 6), look_at: vec(0, 1.2, 0)
