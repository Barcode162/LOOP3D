# A tiny two-scene story, to show how a story runs start to finish:
# lines on screen, a choice, and going on to the next scene.
title "The Gate"
mode "movie"
ground 30, material: "grass"
box size: vec(0.3, 2.4, 0.3), at: vec(-1.2, 1.2, -3), material: "old wood"
box size: vec(0.3, 2.4, 0.3), at: vec(1.2, 1.2, -3), material: "old wood"
box size: vec(2.7, 0.25, 0.3), at: vec(0, 2.5, -3), material: "old wood"
let mira = person(at: vec(0.8, 0, -1.5), facing: 200 deg, shirt: material(color: rgb(0.25, 0.35, 0.2)))
sun elevation: 6 deg, toward: 290 deg
sky "physical", haze: 4
sound "wind", volume: 0.5
sound "birds", volume: 0.3
look "golden", bars: 2.39
camera at: vec(0, 1.6, 4), look_at: vec(0, 1.3, -2), lens: 35 mm
shot "the gate", 30 s, from: {at: vec(0, 1.6, 4), look_at: vec(0, 1.3, -2), lens: 35 mm}, to: {at: vec(0, 1.5, 2.5), look_at: vec(0, 1.3, -2), lens: 40 mm}, fade_in: 2 s

task
  wait 2 s
  mira.look_at = vec(0, 1.6, 4)
  wait line("Mira", "The lamps have all gone out.")
  wait line("Mira", "Will you come with me, through the gate?")
  ask "What do you say?", ["I'll come.", "Not tonight."]

when "choice"
  if event == 0
    wait line("Mira", "Then stay close.")
    mira.walk_to = vec(0, 0, -5)
    wait 4 s
    go_to "the_woods"
  else
    wait line("Mira", "Then I'll go alone.")
    mira.walk_to = vec(0, 0, -6)
