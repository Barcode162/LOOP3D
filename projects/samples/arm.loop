# An arm of three bones that bends with no gap: one skin, three poses.
# What to look at: the same arm three times, straight, bending and bent to a
# right angle. The middle one bends and straightens on its own, live: the
# phone's graphics chip moves every point of its skin each frame. The elbow
# and the wrist stay one smooth surface: no crack, no fold poking through.
# Each point of the skin is pulled by the bones near it, and near a joint by
# both of its bones at once.
title "The arm"
mode "game"

# the bones: an upper arm, a forearm and a hand, standing straight up
skeleton "arm"
  bone "upper_arm", from: vec(0, 0, 0), to: vec(0, 0.3, 0), bends: vec(1, 0, 0), bend: [-20 deg, 20 deg]
  bone "forearm", parent: "upper_arm", from: vec(0, 0.3, 0), to: vec(0, 0.56, 0), bends: vec(1, 0, 0), bend: [-5 deg, 150 deg], twist: [-80 deg, 80 deg]
  bone "hand", parent: "forearm", from: vec(0, 0.56, 0), to: vec(0, 0.72, 0), bends: vec(1, 0, 0), bend: [-70 deg, 80 deg]

# the skin: an arm's outline spun round, with a ring of points every centimetre so it has somewhere to bend
to arm_outline()
  let outline = [vec(0, 0)]
  for each i in 73
    let h = i * 0.01
    let r = 0.05
    if h < 0.3
      r = 0.05 + 0.012 * sin(h / 0.3 * 180 deg)
    else if h < 0.56
      r = 0.05 - 0.016 * (h - 0.3) / 0.26 + 0.008 * sin((h - 0.3) / 0.26 * 180 deg)
    else
      r = 0.034 + 0.012 * sin((h - 0.56) / 0.16 * 180 deg)
    outline.push(vec(r, h))
  outline.push(vec(0, 0.725))
  return outline

to arm(x, elbow, wrist)
  cylinder(0.11, 0.06, at: vec(x, 0.87, 0), material: "brass")
  let a = lathe(arm_outline(), segments: 48, at: vec(x, 0.9, 0), material: "porcelain")
  skin(a, "arm")
  pose(a, "forearm", bend: elbow)
  pose(a, "hand", bend: wrist)
  return a

box size: vec(12, 0.1, 10), at: vec(0, -0.05, 0), material: "floorboards"
box size: vec(12, 7, 0.1), at: vec(0, 3.5, -2.5), material: "plaster"
box size: vec(2.6, 0.84, 0.6), at: vec(0, 0.42, 0), material: "oak"

arm(-0.85, 0, 0)
let swinging = arm(-0.1, 45 deg, 20 deg)
arm(0.65, 90 deg, 40 deg)

# the middle arm bends and straightens every four seconds, the hand following a moment later
every 0.01 s
  pose swinging, "forearm", bend: 45 deg + 40 deg * wave(time(), 4)
  pose swinging, "hand", bend: 20 deg + 30 deg * wave(time() - 0.35, 4)

light(at: vec(-2, 3, 2.5), lumens: 3000, kelvin: 3000)
light(at: vec(2.5, 2.5, 2), lumens: 1200, kelvin: 4500)
sky "color", color: rgb(0.02, 0.02, 0.03), nits: 3
camera at: vec(0.05, 1.5, 3), look_at: vec(0.05, 1.25, 0), lens: 50 mm
