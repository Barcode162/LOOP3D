# A cabin at night: a fire, a candle, moonlight through the window.
# Render it:  loop render projects/samples/cabin.loop --quality draft
title "The Cabin"
mode "movie"

# ---- the room
ground 12, material: "floorboards"
let walls = material("old wood", roughness: 0.8)
box size: vec(8, 3, 0.2), at: vec(0, 1.5, -3), material: walls
box size: vec(0.2, 3, 6), at: vec(4, 1.5, 0), material: walls
box size: vec(8, 0.2, 6), at: vec(0, 3.1, 0), material: walls
# the left wall, with a window
box size: vec(0.2, 3, 2.2), at: vec(-4, 1.5, -1.9), material: walls
box size: vec(0.2, 3, 2.2), at: vec(-4, 1.5, 1.9), material: walls
box size: vec(0.2, 0.9, 1.6), at: vec(-4, 0.45, 0), material: walls
box size: vec(0.2, 1.0, 1.6), at: vec(-4, 2.5, 0), material: walls
box size: vec(0.03, 1.1, 1.6), at: vec(-4, 1.45, 0), material: "glass"

# ---- the hearth: an open stone fireplace against the back wall
let stone = material("stone")
box size: vec(1.8, 1.3, 0.2), at: vec(1.6, 0.65, -2.8), material: stone          # back
box size: vec(0.35, 1.0, 0.5), at: vec(0.88, 0.5, -2.55), material: stone        # left side
box size: vec(0.35, 1.0, 0.5), at: vec(2.32, 0.5, -2.55), material: stone        # right side
box size: vec(1.9, 0.22, 0.6), at: vec(1.6, 1.11, -2.5), material: "old wood"    # mantel
box size: vec(1.1, 0.06, 0.5), at: vec(1.6, 0.03, -2.5), material: stone         # hearth floor
for i from 0 to 5
  let log = cylinder(0.06, 0.6, at: vec(1.6 + (i - 2.5) * 0.08, 0.15, -2.45), material: "bark")
  log.rotation = vec(0, 0, 90 deg + i * 7 deg)
box size: vec(0.5, 0.1, 0.25), at: vec(1.6, 0.12, -2.45), material: "ember", collide: no
let fire = light(vec(1.6, 0.42, -2.35), lumens: 900, kelvin: 1900, radius: 0.12)

# ---- the table and its candle
box size: vec(1.6, 0.06, 0.9), at: vec(-0.6, 0.74, 0.2), material: "walnut", round: 0.01
for each corner in [vec(-1.3, 0.36, -0.15), vec(0.1, 0.36, -0.15), vec(-1.3, 0.36, 0.55), vec(0.1, 0.36, 0.55)]
  box size: vec(0.06, 0.72, 0.06), at: corner, material: "walnut"
cylinder 0.035, 0.22, at: vec(-0.4, 0.88, 0.25), material: "wax"
sphere 0.012, at: vec(-0.4, 1.0, 0.25), scale: vec(1, 2, 1), material: "flame"
let candle = light(vec(-0.4, 1.01, 0.25), lumens: 14, kelvin: 1850, radius: 0.01)
sphere 0.1, at: vec(-0.95, 0.87, 0.35), material: "brass"
box size: vec(1.8, 0.01, 1.2), at: vec(0.6, 0.005, -0.9), material: material("wool", color: rgb(0.45, 0.12, 0.1), pattern: "checker", pattern_color: rgb(0.3, 0.25, 0.15), pattern_scale: 3)

# ---- outside: a cold moon and stars
sun elevation: 25 deg, toward: 250 deg, lux: 0.3, kelvin: 4100
sky "physical", stars: 0.02
fog 0.006, from: vec(-4, 0, -3), to: vec(4, 3, 3), glow: 0.5

# ---- alive: the fire and the flame flicker
every 1 / 30 s
  fire.lumens = 900 * (1 + 0.25 * flicker(time(), 6, 1))
  candle.lumens = 14 * (1 + 0.15 * flicker(time(), 9, 2))

# ---- the shots
look "golden", grain: 0.03, bars: 2.39
camera at: vec(-2.6, 1.4, 2.4), look_at: vec(0, 0.8, -1), lens: 28 mm, f_stop: 2.8, exposure: -1
shot "wide", 3 s, from: {at: vec(-2.6, 1.5, 2.6), look_at: vec(0.4, 0.8, -1.5), lens: 24 mm}, to: {at: vec(-2.2, 1.3, 2.0), look_at: vec(0.6, 0.7, -1.6), lens: 28 mm}, fade_in: 1 s
shot "candle", 3 s, from: {at: vec(0.4, 1.05, 1.2), look_at: vec(-0.4, 0.95, 0.25), lens: 50 mm, f_stop: 1.8}, to: {at: vec(0.2, 1.0, 0.9), look_at: vec(-0.4, 0.95, 0.25), lens: 85 mm, f_stop: 1.8}, shake: 0.3, fade_out: 1 s

render file: "cabin.png", quality: "good", width: 1280, at: 1 s
