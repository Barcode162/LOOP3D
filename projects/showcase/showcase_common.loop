# Showcase: what every room shares. A room starts with:  use "showcase_common"
#
# Every room shows one thing the engine does, before and after: walk to the
# glowing plinth and press Use (E, or the Use button) to switch.

# ---- Use: remember when it was last pressed
let used_at = -1
when "use"
  used_at = time()

# ---- before / after
# `apply` is a function the room gives: apply(yes) shows the feature,
# apply(no) the plain version. The room starts showing it.
let showing_after = yes
to before_after(at, apply, what: "this room's feature")
  let glow = material(color: rgb(0.02, 0.03, 0.04), glow: rgb(0.35, 0.75, 1.0) * 900)
  box size: vec(0.7, 0.95, 0.7), at: at + vec(0, 0.475, 0), material: "marble", round: 0.03
  let halo = ring(0.32, 0.025, at: at + vec(0, 1.0, 0), material: glow, collide: no)
  apply(yes)
  task
    let seen = time()
    wait 1.5 s
    line "", "Walk to the glowing plinth and press Use (E) to see " + what + " before and after.", seconds: 6
    repeat forever
      if used_at > seen and near(at, 2.4)
        seen = used_at
        showing_after = not showing_after
        apply(showing_after)
        line "", ("After: " if showing_after else "Before: ") + what, seconds: 3
      wait 0.1 s
      halo.turn = time() * 0.8

# ---- a plain room: floor, four walls with a doorway toward +z, a ceiling
# with a soft panel light. `size` is inside width, height, depth.
to room_shell(size: vec(12, 4.5, 12), floor: "tiles", walls: "plaster", lumens: 6000)
  let w = size.x
  let h = size.y
  let d = size.z
  box size: vec(w, 0.2, d), at: vec(0, -0.1, 0), material: floor
  box size: vec(w, h, 0.3), at: vec(0, h / 2, -d / 2 - 0.15), material: walls
  box size: vec(0.3, h, d), at: vec(-w / 2 - 0.15, h / 2, 0), material: walls
  box size: vec(0.3, h, d), at: vec(w / 2 + 0.15, h / 2, 0), material: walls
  # the front wall, with a doorway 2 m wide back to the hall
  box size: vec(w / 2 - 1, h, 0.3), at: vec(-(w / 4 + 0.5), h / 2, d / 2 + 0.15), material: walls
  box size: vec(w / 2 - 1, h, 0.3), at: vec(w / 4 + 0.5, h / 2, d / 2 + 0.15), material: walls
  box size: vec(2, h - 2.6, 0.3), at: vec(0, 2.6 + (h - 2.6) / 2, d / 2 + 0.15), material: walls
  box size: vec(w, 0.2, d), at: vec(0, h + 0.1, 0), material: walls
  panel_light at: vec(0, h - 0.02, 0), facing: vec(0, -1, 0), size: vec(w * 0.4, d * 0.4, 0), lumens: lumens, kelvin: 4500
  room size: 0.25, echo: 0.12

# ---- the way back: walk out of the doorway (at +z) to return to the hall
to door_back(depth: 12)
  task
    wait 2 s
    repeat forever
      if near(vec(0, 0, depth / 2 + 0.6), 1.0)
        go_to "showcase_hall"
        return
      wait 0.2 s

# ---- the player's start and view, facing into the room (toward -z)
to enter_room(depth: 12)
  move_player at: vec(0, 0, depth / 2 - 1.2), look_at: vec(0, 1.4, 0)
  camera at: vec(0, 1.6, depth / 2 - 1.2), look_at: vec(0, 1.3, 0), lens: 24 mm

# ---- small helpers
to plinth(at, height: 1.0, material: "marble")
  return box(size: vec(0.6, height, 0.6), at: at + vec(0, height / 2, 0), material: material, round: 0.02)
# a beam laid from one point to another (along x)
to lintel(a, b, height: 0.42, depth: 0.7, material: "ruin stone")
  let mid = (a + b) / 2
  let len = distance(vec(a.x, 0, a.z), vec(b.x, 0, b.z))
  return box(size: vec(len, height, depth), at: mid, material: material, round: 0.04)
