# Light: real lamps. Before: one bare bulb, no shadows. After: a warm lamp, a
# cool lamp, a spotlight on the statue, a softbox, ray-traced lamp shadows.
use "showcase_common"
title "Light"
mode "game"
room_shell(size: vec(12, 4.5, 12), floor: "concrete", walls: "plaster", lumens: 0)
# a statue: a bust on a column, and a chair, so there are shadows to see
column(at: vec(0, 0, -2), height: 1.3, radius: 0.22, material: "marble")
sphere 0.28, at: vec(0, 1.62, -2), material: "marble"
box size: vec(0.5, 0.05, 0.5), at: vec(2, 0.45, -1), material: "oak"
box size: vec(0.5, 0.6, 0.05), at: vec(2, 0.75, -1.25), material: "oak"
for each lx in [1.8, 2.2]
  for each lz in [-1.2, -0.8]
    box size: vec(0.04, 0.45, 0.04), at: vec(lx, 0.225, lz), material: "oak"
let bulb = light(at: vec(0, 3.6, 2), lumens: 600, kelvin: 3000, radius: 0.05)
let warm = light(at: vec(-3, 2.2, 0), lumens: 1500, kelvin: 2400, radius: 0.08)
let cool = light(at: vec(3.5, 2.6, -3), lumens: 1200, kelvin: 7000, radius: 0.08)
let spot = light(at: vec(0, 4.2, 1), lumens: 2500, kelvin: 4000, aim: vec(0, 1.2, -2), angle: 18 deg, radius: 0.05)
let soft = panel_light(at: vec(-5.8, 2.2, -2), facing: vec(1, 0, 0), size: vec(1.5, 1.2, 0), lumens: 3500, kelvin: 5600)
to show(on)
  bulb.lumens = 0 if on else 600
  warm.lumens = 1500 if on else 0
  cool.lumens = 1200 if on else 0
  spot.lumens = 2500 if on else 0
  soft.lumens = 3500 if on else 0
  setting "render.lamps", 4 if on else 0
  setting "render.rays", 4 if on else 1
before_after(vec(3, 0, 3.5), show, what: "lamps with real brightness, colour and ray-traced shadows")
enter_room()
door_back()
look "natural", bloom: 0.06
