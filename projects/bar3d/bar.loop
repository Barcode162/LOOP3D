let dim = 1
let dimTarget = 1
every 1 / 30 s
  dim = approach(dim, dimTarget, 2.5, 1 / 30)
  let t = time()
  for each l in lamps
    let k = shine(l, t)
    if l.dims
      k = k * dim
    l.light.lumens = l.base * k

# the light switch by the door: lights down over the bar, and up again
when "use"
  if near(vec(2.25, 1.2, 6.95), within: 1.5 m)
    dimTarget = 25% if dimTarget == 1 else 1


# the room's sound
room size: 0.5
sound "fire", at: vec(-8.57, 0.161, 0.8), volume: 0.6

# 282 walls, furniture and raised floors to bump into (invisible)
