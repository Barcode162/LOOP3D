# ---- the bar's life: every lamp breathes, buzzes or waves on its own
# (the original's light rig), the light switch dims the bar
let lamps = []
let seeds = 0
to lamp(l, rule, dims)
  seeds += 1
  lamps.push({light: l, base: l.lumens, rule: rule, dims: dims, seed: seeds * 7.31})
  return l

to breathe(t, seed, amount: 6%, period: 8 s, speed: 0.5)
  return 1 + amount * noise(t * speed * 4 / period, seed, 0)
to buzz(t, seed, amount: 12%, period: 2 s, speed: 1)
  return 1 + amount * flicker(t, speed * 4 / period, seed)

to shine(l, t)
  if l.rule == "breathe"
    return breathe(t, l.seed)
  if l.rule == "strings"
    return breathe(t, l.seed, amount: 4%, period: 9 s, speed: 0.4)
  if l.rule == "neon"
    return buzz(t, l.seed, speed: 0.8)
  if l.rule == "wave"
    return 1 + 18% * wave(t, 5 s)
  if l.rule == "sign"
    return buzz(t, l.seed, amount: 60%, period: 1.2 s)
  if l.rule == "fire"
    return buzz(t, l.seed, amount: 40%, period: 0.5 s)
  if l.rule == "jukebox"
    return 1 + 20% * wave(t, 3 s)
  return 1

# 103 lamps (lumens and kelvin as in the bar)
lamp(light(vec(-6.6, 2.11, -4.6), lumens: 360, kelvin: 2700, radius: 0.08), "breathe", yes)  # light-bulb-1
lamp(light(vec(-4.3, 2.11, -4.6), lumens: 360, kelvin: 2700, radius: 0.08), "breathe", yes)  # light-bulb-2
lamp(light(vec(-2, 2.11, -4.6), lumens: 360, kelvin: 2700, radius: 0.08), "breathe", yes)  # light-bulb-3
lamp(light(vec(0.2, 2.11, -4.6), lumens: 360, kelvin: 2700, radius: 0.08), "breathe", yes)  # light-bulb-4
lamp(light(vec(-6.281, 1.985, -7.054), lumens: 144, kelvin: 2700, radius: 0.3), "breathe", no)  # light-bulb-5
lamp(light(vec(-1.544, 1.985, -7.056), lumens: 144, kelvin: 2700, radius: 0.3), "breathe", no)  # light-bulb-6
lamp(light(vec(-4.511, 2.005, -7.123), lumens: 162, kelvin: 2700, radius: 0.03), "breathe", no)  # light-bulb-7
lamp(light(vec(-8.0116, 3.424, -2.887), lumens: 37.5, kelvin: 5000, radius: 0.03), "strings", yes)  # string-light-1-1
lamp(light(vec(-6.8372, 3.3247, -2.0623), lumens: 37.5, kelvin: 5000, radius: 0.03), "strings", yes)  # string-light-1-1
