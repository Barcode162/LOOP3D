# towel_rail · a brass towel rail on the wall with towels hung over it, and a pile of folded ones
# towel_rail(at, turn, width, color, folded) fixes it with `at` the middle of the rail's fixing on the wall, facing -z:
# `width` (0.6 m); one towel hung over it; `folded` (0..3) folded towels stacked on the floor under it.
#
# kind: model
# place: towel_rail(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: towels, towel rail, bathroom, loft
# size: chair
# seeds: none, the same every time
to towel_rail(at: vec(0, 0, 0), turn: 0, width: 0.6, color: rgb(0.85, 0.83, 0.78), folded: 0)
  let terry = material(like: "wool", color: color, roughness: 1, sheen: 0.5)
  let g = group(at: at, turn: turn)
    box size: vec(width, 0.016, 0.016), at: vec(0, 0, -0.08), material: "brass", round: 0.006, collide: no
    for each s in [-1, 1]
      box size: vec(0.014, 0.014, 0.08), at: vec(s * (width / 2 - 0.01), 0, -0.04), material: "brass", collide: no
    box size: vec(width * 0.8, 0.55, 0.012), at: vec(0, -0.27, -0.1), material: terry, round: 0.005, collide: no
    box size: vec(width * 0.8, 0.4, 0.012), at: vec(0, -0.19, -0.06), material: terry, round: 0.005, collide: no
    box size: vec(width * 0.8, 0.025, 0.05), at: vec(0, 0.005, -0.08), material: terry, round: 0.012, collide: no
  for each i in range(0, folded, 1)
    box size: vec(0.34, 0.05, 0.26), at: at + vec(0 - sin(turn) * 0.16, 0 - at.y + 0.025 + i * 0.05, 0 - cos(turn) * 0.16), turn: turn, material: terry, round: 0.02, collide: no
  return g
