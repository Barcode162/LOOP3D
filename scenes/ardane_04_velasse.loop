# 4. The Drowned City — WATCHED. Dawn mist turning gold.
use "ardane_common"
title "4 · Velasse, the Drowned City"
mode "movie"

velasse_city(count: 40, spread: 60)
# the alley is a canal now: two tall towers either side
let stone = material(like: "stone", color: rgb(0.55, 0.5, 0.42))
box size: vec(6, 18, 22), at: vec(-5.2, 8.5, -8), material: stone
box size: vec(6, 16, 22), at: vec(5.2, 7.5, -8), material: stone
rope_bridge(vec(-2.2, 6, -12), vec(2.2, 6, -12))
for z from 2 to -18 by -5
  lantern vec(-2.15, 3, z), lumens: 150
  lantern vec(2.15, 3.4, z - 2), lumens: 150
let dock = raft(vec(0, 0, 0), size: vec(2.6, 0.3, 2.2))
let boat = raft(vec(0, 0, -16), size: vec(1.2, 0.3, 3.6))

let milo = hero(vec(0, 0.05, 0.4), facing: 180 deg)
milo.sitting = yes
let nia = someone(vec(0, 0.15, -16), height: 1.62, shirt: cloth(0.55, 0.18, 0.15), trousers: cloth(0.2, 0.18, 0.14), skin: skin_deep)

sound "stream", volume: 0.5
sound "birds", volume: 0.35
sound "bell", "metal", at: vec(30, 20, -60), strength: 0.4
room 0.1
sky "physical", haze: 6
sun elevation: 5 deg, toward: 180 deg, lux: 60000
fog 0.03, top: 6, glow: 0.8, color: rgb(1, 0.95, 0.9)
look "golden", bars: 2.39

camera at: vec(0, 3, 10), look_at: vec(0, 2, -10), lens: 24 mm
shot "the canal", 10 s, from: {at: vec(0.5, 6, 14), look_at: vec(0, 3, -20), lens: 24 mm, f_stop: 5.6}, to: {at: vec(0.3, 3, 7), look_at: vec(0, 1.5, -14), lens: 28 mm}, fade_in: 2 s
shot "he wakes", 7 s, from: {at: vec(1.2, 0.9, 2.2), look_at: vec(0, 0.8, 0.4), lens: 50 mm, f_stop: 2}, to: {at: vec(1.0, 0.9, 1.8), look_at: vec(0, 0.9, 0.3), lens: 60 mm, f_stop: 2}
shot "nia", 11 s, from: {at: vec(-0.8, 1.2, 2.8), look_at: vec(0, 1.5, -6), lens: 50 mm, f_stop: 2.8}, to: {at: vec(-0.4, 1.3, 2), look_at: vec(0, 1.5, -3), lens: 70 mm, f_stop: 2.8}
shot "two of them", 8 s, from: {at: vec(3, 2.5, 5), look_at: vec(0, 1, -1), lens: 35 mm}, to: {at: vec(2.2, 2.2, 3.8), look_at: vec(0, 1, -1), lens: 40 mm}, fade_out: 1.5 s
render file: "ardane_04_velasse.png", quality: "good", width: 1280, at: 19 s

task
  wait 6 s
  milo.look_at = vec(0, 6, -10)
  wait 2 s
  say "", "Water. Towers. Bells. The same narrow walls, but the alley is a canal."
  nia.walk_to = vec(0, 0.15, -2)
  boat.position = vec(0, -0.3, -16)
  every 1 / 30 s
    let z = boat.position.z
    if z < -2.2
      boat.position = vec(0, boat.position.y, z + 0.05)
      nia.position = vec(0, 0.15, z + 0.05)
  wait 4 s
  nia.look_at = vec(0, 1, 0.4)
  say "Nia", "You're lucky. The Veyra boats would've run you over and charged you for the dent."
  milo.sitting = no
  say "Milo", "Where... is this?"
  say "Nia", "Velasse. Where else?"
  say "Nia", "...Hold still. You've got the Ardane look. Grandpa's going to cry."
  next_scene "ardane_05_canals", delay: 2 s
