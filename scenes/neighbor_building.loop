# neighbor_building · the building next door: an old brick block across the street, rows of windows (some lit, warm, most dark), a
# parapet, a cornice and a black iron fire escape zig-zagging down its face
# neighbor_building(at, turn, width, height, depth, lit, seed) stands it with `at` the middle of its front at the
# street, its face towards +z (it faces you across the street): `width` (22 m), `height` (44 m), `depth` (14 m).
# `lit` (0..1) is the share of windows lit; each seed lights different ones. No lamps: the windows glow.
#
# kind: piece
# place: neighbor_building(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: building, brick, city, neighbour, windows, fire escape, night, outside, loft
# size: land
# seeds: any whole number
to neighbor_building(at: vec(0, 0, 0), turn: 0, width: 22, height: 44, depth: 14, lit: 0.22, seed: 1)
  let face = material(color: rgb(0.16, 0.07, 0.05), roughness: 0.85, pattern: "windows", floor: 3.3, bay: 2.6, window: vec(1.3, 1.9), lit: lit, glow: 16, seed: seed, pattern_color: rgb(0.02, 0.025, 0.035))
  let side = material(color: rgb(0.12, 0.055, 0.04), roughness: 0.9)
  let stone = material(color: rgb(0.32, 0.3, 0.27), roughness: 0.8)
  let iron = material(color: rgb(0.02, 0.02, 0.02), metal: 1, roughness: 0.6)
  let g = group(at: at, turn: turn)
    box size: vec(width, height - 4, depth), at: vec(0, 4 + (height - 4) / 2, 0 - depth / 2), material: face
    box size: vec(width, 4, depth), at: vec(0, 2, 0 - depth / 2), material: side
    # the shop floor: dark glass and a stone band over it
    box size: vec(width, 4, 0.06), at: vec(0, 2, 0.04), material: material(color: rgb(0.02, 0.02, 0.025), roughness: 0.1), collide: no
    box size: vec(width + 0.3, 0.5, 0.4), at: vec(0, 4.1, 0.2), material: stone, collide: no
    # the parapet and a cornice at the top
    box size: vec(width + 0.6, 0.6, 0.7), at: vec(0, height - 0.6, 0.35), material: stone, collide: no
    box size: vec(width, 1.1, 0.3), at: vec(0, height + 0.55, -0.15), material: side, collide: no
    # the fire escape: a landing at every second floor, a stair between, rails
    let x0 = width * 0.22
    for each k in range(0, floor((height - 8) / 6.6), 1)
      let y = 7.3 + k * 6.6
      box size: vec(3.2, 0.06, 1.2), at: vec(x0, y, 0.65), material: iron, collide: no
      box size: vec(3.2, 0.05, 0.05), at: vec(x0, y + 1.0, 1.25), material: iron, collide: no
      for each s in [-1, 1]
        box size: vec(0.05, 1.0, 0.05), at: vec(x0 + s * 1.6, y + 0.5, 1.25), material: iron, collide: no
      box size: vec(0.7, 0.05, 7.4), at: vec(x0 + ((k % 2) * 2 - 1) * 0.9, y + 3.3, 0.7), rotation: vec(90 deg, 0, ((k % 2) * 2 - 1) * 63 deg), material: iron, collide: no
  return g
