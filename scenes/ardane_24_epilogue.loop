# 24. The Room Above the Laundry — WATCHED. A spring evening, months later.
use "ardane_common"
title "24 · The Room Above the Laundry"
mode "movie"

# ---- home, the window open, gold evening light
home_room(daylight: 9000, daylight_temp: 3600)
let fam = the_family()
let nana = fam.nana
let rosa = fam.rosa
let bea = fam.bea
# Nana's bed by the window; she's very old and very pleased
nana.look_at = vec(2.8, 1.6, 0.1)
rosa.look_at = vec(-1.4, 0.8, -1.4)
bea.position = vec(0.4, 0, 0.6)
# Bea's drawing: five worlds and a boy with a lantern
let drawing = box(size: vec(0.42, 0.005, 0.3), at: vec(0.6, 0.005, 0.2), turn: 15 deg, material: "paper", collide: no)
for i from 0 to 4
  sphere 0.035, at: vec(0.48 + i * 0.06, 0.01, 0.15 + 0.03 * sin(i)), scale: vec(1, 0.1, 1), material: material(like: "paper", color: relic_colors[i]), collide: no
# the letter, on the table
box size: vec(0.2, 0.004, 0.14), at: vec(-1.7, 0.77, -1.3), turn: -10 deg, material: "paper", collide: no
candle vec(-1.9, 0.765, -1.25)
# the tin box under the bed, the relics quiet in it
box size: vec(0.3, 0.12, 0.2), at: vec(2.1, 0.06, 0.2), material: "aluminium", collide: no

# ---- outside: Calder Row at dusk, the alley and its faint ring
let street_at = vec(0, 0, 200)
let wet = material(like: "concrete", color: rgb(0.2, 0.2, 0.22), roughness: 0.6)
box size: vec(30, 0.1, 40), at: street_at + vec(0, -0.05, 0), material: wet
box size: vec(0.5, 9, 14), at: street_at + vec(-1.95, 4.5, -9), material: "brick"
box size: vec(0.5, 9, 14), at: street_at + vec(1.95, 4.5, -9), material: "brick"
box size: vec(4, 9, 0.5), at: street_at + vec(0, 4.5, -16), material: "brick"
for each x in [-6, 6]
  box size: vec(8, 10, 6), at: street_at + vec(x, 5, 3), material: "brick"
faint_portal(street_at + vec(0, 1.5, -14.5), facing: 0 deg)
street_lamp street_at + vec(-2.6, 0, 1), temp: 2000, lumens: 1800
# home's warm window, the other way
box size: vec(1.2, 1.1, 0.06), at: street_at + vec(-4, 4.6, 6.05), material: material(color: rgb(0, 0, 0), glow: kelvin(2000) * 150), collide: no
light street_at + vec(-4, 4.6, 5.5), lumens: 300, kelvin: 2000, radius: 0.4

let milo = hero(vec(-1.1, 0, 2.2), facing: 180 deg)
milo.visible = yes

sound "birds", volume: 0.6
room 0.2, echo: 0.1
sky "physical", haze: 3
sun elevation: 6 deg, toward: 270 deg, lux: 25000, kelvin: 4200
look "golden", warmth: 0.3, bloom: 0.25, grain: 0.02, bars: 2.39

camera at: vec(-0.4, 1.5, 1.9), look_at: vec(1.2, 1.0, 0.3), lens: 28 mm, f_stop: 2.8
shot "home from work", 18 s, from: {at: vec(-2.4, 1.5, 1.8), look_at: vec(-1.1, 1.4, 2.4), lens: 28 mm, f_stop: 2.8}, to: {at: vec(-2.2, 1.5, 0.6), look_at: vec(1.5, 1.0, 0.6), lens: 28 mm, f_stop: 2.8}, ease: "in_out", fade_in: 2.5 s
shot "Bea's drawing", 16 s, from: {at: vec(0.9, 1.1, 0.9), look_at: vec(0.6, 0.05, 0.2), lens: 45 mm, f_stop: 2.8}, to: {at: vec(0.8, 0.9, 0.8), look_at: vec(0.6, 0.05, 0.2), lens: 50 mm, f_stop: 2.8}
shot "the letter", 20 s, from: {at: vec(-0.6, 1.3, -0.4), look_at: vec(-1.6, 0.85, -1.3), lens: 40 mm, f_stop: 2.8}, to: {at: vec(-0.7, 1.3, -0.6), look_at: vec(-1.6, 0.9, -1.0), lens: 45 mm, f_stop: 2.8}
shot "little lamp", 29 s, from: {at: vec(0.9, 1.3, 1.6), look_at: vec(2.3, 0.9, 1.0), lens: 50 mm, f_stop: 2}, to: {at: vec(1.1, 1.25, 1.5), look_at: vec(2.3, 0.85, 1.05), lens: 65 mm, f_stop: 2}
shot "the alley at dusk", 27 s, from: {at: street_at + vec(0.2, 1.5, 6), look_at: street_at + vec(0, 1.5, -14), lens: 35 mm, f_stop: 2.8}, to: {at: street_at + vec(0.2, 1.6, 3.5), look_at: street_at + vec(0, 1.5, -14), lens: 40 mm, f_stop: 2.8}, look: "golden"
shot "home for dinner", 20 s, from: {at: street_at + vec(1.2, 1.6, -4), look_at: street_at + vec(-1, 1.5, 4), lens: 28 mm}, to: {at: street_at + vec(1.2, 2.6, -8), look_at: street_at + vec(-4, 4, 6), lens: 24 mm}, ease: "in_out", fade_out: 5 s
render file: "ardane_24_epilogue.png", quality: "good", width: 1280, at: 111 s

task
  wait 2 s
  say "", "Spring. Months later. The window is open."
  milo.walk_to = vec(-0.2, 0, 0.9)
  say "", "Milo comes home from work. A job at the market, his name said plainly."
  say "", "There's a white streak in his hair. His left hand still shakes when he's tired. There's a silence in him he'll always have."
  wait 2 s
  bea.look_at = milo.position + vec(0, 1.5, 0)
  say "Bea", "Milo! I drew you again. Look, five worlds. And that's you with the lantern."
  say "Milo", "Why am I so big?"
  say "Bea", "Because you're the big one."
  milo.look_at = vec(-1.6, 0.8, -1.4)
  rosa.look_at = milo.position + vec(0, 1.5, 0)
  say "Rosa", "There's a letter. From a Julian Varen. It just says, 'I'm sorry.'"
  if recall("took the coins", otherwise: no)
    say "Rosa", "And Nana's medicine came. Paid. Nobody will tell me by whom."
  say "", "Rosa sleeps more these days. She's smiling now, a little, at nothing."
  milo.walk_to = vec(1.6, 0, 0.9)
  wait 3 s
  milo.look_at = nana.position + vec(0, 1.0, 0)
  nana.look_at = milo.position + vec(0, 1.5, 0)
  say "Nana", "Did you say hello to them, little lamp?"
  pause 1 s
  say "Milo", "All of them."
  say "Nana", "And?"
  pause 2 s
  say "", "He smiles. For the first time in all of it, he really smiles."
  say "Milo", "They left the light on."
  pause 4 s
  # dusk: the mouth of the alley
  say "", "Dusk. He walks down to the mouth of Thirteenth Alley."
  milo.position = street_at + vec(0.2, 0, -2)
  milo.look_at = street_at + vec(0, 1.5, -14.5)
  wait 3 s
  say "", "Deep inside, faint as a breath, the ring of light is still there."
  pause 6 s
  say "", "He looks at it for a long time."
  pause 4 s
  milo.look_at = nothing
  milo.walk_to = street_at + vec(-3, 0, 5)
  say "", "Then he turns, hood down, and walks home."
  pause 3 s
  say "", "The portal stays. The story doesn't end. It just goes home for dinner."
  pause 8 s
  say "", "ECHOES OF ARDANE"
  next_scene "ardane_01_home", delay: 6 s
