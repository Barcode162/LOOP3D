# records · a crate of records standing on end, their sleeves in many colours, one leaning out in front
# records(at, turn, count, seed) stands it on `at`, the records' faces towards ±x: 0.34 m wide, 0.34 m tall.
#
# kind: model
# place: records(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: records, vinyl, albums, music, living, loft
# size: hand
# seeds: any whole number
to records(at: vec(0, 0, 0), turn: 0, count: 24, seed: 1)
  let sleeves = [rgb(0.7, 0.15, 0.08), rgb(0.1, 0.12, 0.18), rgb(0.85, 0.8, 0.65), rgb(0.12, 0.3, 0.32), rgb(0.85, 0.55, 0.1), rgb(0.05, 0.05, 0.05), rgb(0.4, 0.2, 0.35)]
  let g = group(at: at, turn: turn)
    box size: vec(0.4, 0.2, 0.36), at: vec(0, 0.1, 0), material: "pine", round: 0.004
    for each i in range(0, count, 1)
      let k = floor((noise(seed, i * 1.3, 0.2) + 1) * 3.49)
      box size: vec(0.012, 0.31, 0.31), at: vec(-0.18 + i * 0.0145, 0.16, 0), rotation: vec(0, 0, noise(seed, i, 0.8) * 0.05), material: material(like: "paper", color: sleeves[max(0, min(6, k))]), collide: no
    box size: vec(0.31, 0.31, 0.006), at: vec(0, 0.155, -0.2), tilt: 12 deg, material: material(like: "paper", color: rgb(0.85, 0.3, 0.1)), collide: no
  return g
