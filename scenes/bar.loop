let dim = 1
let dimTarget = 1
every 1 / 30 s
  # lights down: to 25% in about 0.3 s (the rig's "fade to 25% over 0.3 s"); the fire in 1.2 s
  dim = approach(dim, dimTarget, 10, 1 / 30)
  fire_mix = approach(fire_mix, 1 if fire_lit else 0, 2.5, 1 / 30)
  let t = time()
  for each l in lamps
    let k = shine(l, t)
    if l.dims
      k = k * dim
    l.on = approach(l.on, l.onTarget, 10, 1 / 30)
    l.light.lumens = l.base * k * l.on

# the light switch by the door: lights down over the bar, and up again
when "use"
  if near(vec(2.25, 1.2, 6.95), within: 1.5 m)
    dimTarget = 25% if dimTarget == 1 else 1

# the music and the fire (sent by the jukebox, the piano, the fireplace)
when "music"
  music_on = yes
  music_start = time()
when "quiet"
  music_on = no
when "fire off"
  fire_lit = no
when "fire on"
  fire_lit = yes


