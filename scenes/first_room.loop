# The first room: a see-through grid of 1-metre squares in a dark space. Only its
# lines show, glowing softly, so a new project opens on something you can judge
# sizes by. You stand on the floor even where you can see through it.
title "New Project"
sky "color", color: rgb(0.8, 0.85, 1.0), nits: 8
ground 60, material: material("grey", color: rgb(0.5, 0.5, 0.5), opacity: 0, glow: 90, pattern: "grid", pattern_color: rgb(0.5, 0.5, 0.5), pattern_scale: 1)
camera at: vec(0, 1.6, 6), look_at: vec(0, 1.2, 0), auto_exposure: no
