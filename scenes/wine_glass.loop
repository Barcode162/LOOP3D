# wine_glass · a thin wine glass on a long stem, empty or with red wine in it
# wine_glass(at, wine) stands it on `at`: 0.21 m tall. With `wine` above 0 (0 to 1) the bowl holds that share of a pour.
#
# kind: model
# place: wine_glass(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: glass, wine glass, stemware, kitchen, dining, table, loft
# size: hand
# seeds: none, the same every time
to wine_glass(at: vec(0, 0, 0), wine: 0)
  let g = group(at: at)
    lathe(profile: [vec(0, 0), vec(0.035, 0), vec(0.035, 0.003), vec(0.004, 0.006), vec(0.0035, 0.1), vec(0.03, 0.125), vec(0.042, 0.16), vec(0.036, 0.21), vec(0.034, 0.21), vec(0.04, 0.16), vec(0.028, 0.127), vec(0, 0.112)], segments: 32, material: "glass", collide: no)
    if wine > 0
      lathe(profile: [vec(0, 0.113), vec(0.027, 0.128), vec(0.036, 0.13 + wine * 0.03), vec(0, 0.13 + wine * 0.03)], segments: 28, material: material(like: "glass", color: rgb(0.35, 0.02, 0.04)), collide: no)
  return g
