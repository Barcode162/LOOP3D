# dish_rack · a steel dish rack on a drip tray, plates standing in it and a glass upturned
# dish_rack(at, turn) stands it on `at`: 0.42 m long, 0.3 m wide.
#
# kind: model
# place: dish_rack(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: dish rack, drainer, kitchen, counter, plates, loft
# size: hand
# seeds: none, the same every time
to dish_rack(at: vec(0, 0, 0), turn: 0)
  let wire = material(like: "chrome", roughness: 0.2)
  let g = group(at: at, turn: turn)
    box size: vec(0.44, 0.012, 0.32), at: vec(0, 0.006, 0), material: material(like: "plastic", color: rgb(0.85, 0.85, 0.85)), round: 0.005, collide: no
    for each x in [-0.2, 0.2]
      box size: vec(0.006, 0.1, 0.3), at: vec(x, 0.062, 0), material: wire, collide: no
    for each z in [-0.14, 0.14]
      box size: vec(0.4, 0.006, 0.006), at: vec(0, 0.11, z), material: wire, collide: no
    for each i in range(0, 4, 1)
      cylinder(radius: 0.12, height: 0.012, at: vec(-0.12 + i * 0.045, 0.13, 0.02), rotation: vec(0, 0, 80 deg), material: "porcelain", sides: 32, collide: no)
    lathe(profile: [vec(0, 0.1), vec(0.04, 0.1), vec(0.036, 0.012), vec(0.033, 0.012), vec(0.037, 0.097), vec(0, 0.097)], segments: 24, at: vec(0.13, 0, -0.06), material: "glass", collide: no)
  return g
