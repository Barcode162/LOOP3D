# 2. The Varen Arcade — PLAYED. Day, overcast, cold.
use "ardane_common"
title "2 · The Varen Arcade"
mode "game"

let brick = material("brick")
let stone_floor = material(like: "stone", color: rgb(0.5, 0.48, 0.45), roughness: 0.6)
ground 60, material: stone_floor
# the arcade: two long walls of brick under an iron-and-glass roof
box size: vec(0.4, 7, 34), at: vec(-6.2, 3.5, -8), material: brick
box size: vec(0.4, 7, 34), at: vec(6.2, 3.5, -8), material: brick
for z from 6 to -22 by -4
  box size: vec(12.8, 0.25, 0.25), at: vec(0, 7, z), material: "iron", collide: no
  panel_light at: vec(0, 6.8, z - 2), facing: vec(0, -1, 0), size: vec(6, 2.5), lumens: 9000, kelvin: 6200
# stalls down both sides: a counter, an awning, a lamp
let awnings = [cloth(0.6, 0.15, 0.12), cloth(0.15, 0.35, 0.2), cloth(0.7, 0.55, 0.2), cloth(0.2, 0.25, 0.5)]
let i = 0
for z from 3 to -19 by -4.4
  for each side in [-1, 1]
    box size: vec(2.2, 0.95, 1.2), at: vec(side * 4.6, 0.47, z), material: "old wood"
    box size: vec(2.6, 0.06, 1.8), at: vec(side * 4.6, 2.4, z), tilt: side * 12 deg, material: awnings[i % 4], collide: no
    lantern vec(side * 4.6, 2.1, z), temp: 2400, lumens: 300
    i += 1
# fruit on one stall, crates by the cart
for k from 0 to 11
  sphere 0.05, at: vec(-4.2 + (k % 6) * 0.12, 1.0, 3 + floor(k / 6) * 0.12), material: material(color: rgb(0.95, 0.5, 0.05), roughness: 0.5)
let cart = vec(-1.5, 0, 6)
box size: vec(1.6, 0.7, 1.0), at: cart + vec(0, 0.55, 0), material: "old wood"
crate cart + vec(-0.3, 0.9, 0)
crate cart + vec(0.35, 0.9, 0.1), turn: 12 deg
let fish_stall = vec(4.6, 0, -6)

# the Varen office: stairs up to a gold-lit window
box size: vec(3, 3, 3), at: vec(0, 4.5, -23), material: brick
box size: vec(2.2, 1.2, 0.05), at: vec(0, 4.8, -21.48), material: material(color: rgb(0.1, 0.08, 0.04), glow: kelvin(2700) * 900), collide: no
light vec(0, 4.6, -21.2), lumens: 2500, kelvin: 2700, radius: 0.4
for s from 0 to 9
  box size: vec(2.5, 0.3, 0.4), at: vec(0, 0.15 + s * 0.3, -18.6 - s * 0.4), material: "stone"
let augustin = someone(vec(0, 3, -22.6), height: 1.82, shirt: cloth(0.08, 0.08, 0.1), skin: skin_light)
augustin.look_at = vec(0, 1, -8)
let julian = someone(vec(-0.6, 0.6, -19.4), height: 1.76, shirt: cloth(0.85, 0.82, 0.78), skin: skin_light)
let friend1 = someone(vec(0.8, 0.3, -19), shirt: cloth(0.3, 0.3, 0.35))
let friend2 = someone(vec(-1.6, 0, -18.4), shirt: cloth(0.35, 0.2, 0.2))

# ---- the crowd: shoppers going from stall to stall
let shoppers = []
seed(4)
repeat 14 times
  shoppers.push(someone(vec(random(-3, 3), 0, random(-17, 5))))
every 3 s
  let p = shoppers.pick()
  p.walk_to = vec(random(-3, 3), 0, random(-17, 5))
  p.speed = random(0.9, 1.4)

sound "birds", volume: 0.15
sound "wind", volume: 0.2
room 0.45, echo: 0.2
sky "physical", haze: 7
sun elevation: 25 deg, toward: 200 deg, lux: 25000, kelvin: 6800
look "documentary", grain: 0.025, bars: 2.39
camera at: vec(0.5, 1.5, 9), look_at: vec(-1, 1.1, 5), lens: 30 mm
render file: "ardane_02_market.png", quality: "good", width: 1280, at: 3 s

task
  wait 1 s
  say "Stall-keeper", "Ardane! Crates to the fish stall, and don't drop them this time."
  repeat 2 times
    go_and_use(cart, "Pick up a crate from the cart.")
    sound "thud", "wood", at: cart
    go_and_use(fish_stall, "Carry it to the fish stall.")
    sound "thud", "wood", at: fish_stall
  # Julian comes down the steps
  julian.walk_to = player() + vec(0, 0, -1.5)
  julian.look_at = player() + vec(0, 1.4, 0)
  friend1.walk_to = player() + vec(1.2, 0, -1.8)
  friend2.walk_to = player() + vec(-1.2, 0, -1.8)
  wait 4 s
  say "Julian", "Ardane. That's not even a real name anymore, is it?"
  say "Julian", "Your mother cleans our floors."
  play_knock()
  say "", "He kicks the crate. Oranges roll across the wet stones. People laugh."
  let c = choose("Julian Varen is waiting.", ["'My name is Milo Ardane.'", "Pick up the oranges in silence", "Walk away"])
  remember "market", ["stood up", "kept quiet", "walked away"][c]
  if c == 0
    say "Milo", "My name is Milo Ardane."
    say "Julian", "...Hold him."
    say "", "They grab his jacket. He twists free."
  else if c == 1
    say "", "He kneels and picks up every orange, one at a time. Julian's smile fades."
  else
    say "", "He walks away. Behind him, the laughing follows."
  say "Julian", "THIEF! He took my watch! Guards!"
  say "Milo", "...I didn't—"
  say "", "Run."
  next_scene "ardane_03_alley", delay: 0.5 s

to play_knock()
  sound "impact", "wood", at: player(), strength: 0.8
