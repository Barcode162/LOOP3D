# sculpture · a small sculpture for a shelf, one of three: "loop" (a brass ring on a stone block), "stack" (balanced stones) or "figure" (a smooth bent form)
# sculpture(at, kind, turn) stands it on `at`: about 0.2 m tall.
#
# kind: model
# place: sculpture(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: sculpture, ornament, art, shelf, living, loft
# size: hand
# seeds: none, the same every time
to sculpture(at: vec(0, 0, 0), kind: "loop", turn: 0)
  let g = group(at: at, turn: turn)
    if kind == "loop"
      box size: vec(0.08, 0.04, 0.06), at: vec(0, 0.02, 0), material: "marble", round: 0.004, collide: no
      ring(radius: 0.07, thickness: 0.008, at: vec(0, 0.11, 0), rotation: vec(0, 90 deg, 0), material: "brass", sides: 32)
    else if kind == "stack"
      sphere(radius: 0.05, at: vec(0, 0.02, 0), scale: vec(1.2, 0.45, 1), material: "slate", sides: 16, collide: no)
      sphere(radius: 0.04, at: vec(0.005, 0.06, 0), scale: vec(1.15, 0.5, 1), material: "granite", sides: 16, collide: no)
      sphere(radius: 0.03, at: vec(-0.004, 0.093, 0.002), scale: vec(1.2, 0.55, 1), material: "slate", sides: 14, collide: no)
      sphere(radius: 0.02, at: vec(0.002, 0.117, 0), scale: vec(1.2, 0.6, 1), material: "stone", sides: 12, collide: no)
    else
      box size: vec(0.07, 0.015, 0.07), at: vec(0, 0.0075, 0), material: "black", collide: no
      capsule(radius: 0.022, height: 0.16, at: vec(0, 0.09, 0), rotation: vec(0, 0, 10 deg), material: material(like: "bronze", roughness: 0.35), sides: 12, collide: no)
      sphere(radius: 0.026, at: vec(-0.018, 0.19, 0), material: material(like: "bronze", roughness: 0.35), sides: 14, collide: no)
  return g
