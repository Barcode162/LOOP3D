# fiddle_leaf_fig · a fiddle-leaf fig in a tall pot: a bare trunk branching into big glossy leaves
# fiddle_leaf_fig(at, height, pot, seed) stands it on `at`: `height` (1.8 m) tall, its leaves 25 to 35 cm long.
#
# kind: model
# place: fiddle_leaf_fig(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: plant, fig, fiddle-leaf fig, ficus, tree, indoor, living, loft
# size: chair
# seeds: any whole number
to fiddle_leaf_fig(at: vec(0, 0, 0), height: 1.8, pot: material(like: "concrete", color: rgb(0.55, 0.54, 0.5)), seed: 1)
  let leaf = material(color: rgb(0.1, 0.22, 0.07), roughness: 0.3, clearcoat: 0.5, subsurface: 0.25)
  let trunk = material(color: rgb(0.32, 0.26, 0.2), roughness: 0.9)
  let g = group(at: at)
    lathe(profile: [vec(0, 0), vec(0.17, 0), vec(0.2, 0.42), vec(0.21, 0.45), vec(0.18, 0.45), vec(0, 0.42)], segments: 32, material: pot)
    cylinder(radius: 0.02, height: height * 0.6, at: vec(0, 0.42 + height * 0.3, 0), material: trunk, sides: 8, collide: no)
    for each i in range(0, 34, 1)
      let a = i * 137.5 deg + seed
      let t = i / 34
      let y = 0.42 + height * (0.4 + t * 0.55)
      let rr = 0.12 + sin(t * 3.1) * 0.22 + noise(seed, i, 0.3) * 0.05
      sphere(radius: 0.2, at: vec(cos(a) * rr, y, sin(a) * rr), scale: vec(0.75, 0.06, 1.05), rotation: vec(90 deg - a, 0.35 - t * 0.5, noise(seed, i, 0.8) * 0.4), material: leaf, sides: 10, collide: no)
  return g
