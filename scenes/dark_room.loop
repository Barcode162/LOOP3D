# The Dark Room: nothing but black, a pale corner, a few plain shapes, and one bare bulb that walks slowly
# round them.
# What to look at: every shadow swings as the bulb goes by, sharp where a shape stands on the floor and
# softening the farther it falls from it, as a real bulb's do. Walk round with the stick.
# In the editor: drag in more lamps (Build: the Lamp button, or the library's Lights shelf) and slide their
# ☀ markers; the light and its shadows follow your finger. Two lamps at a time cast shadows on the phone.
title "The Dark Room"
use "dark_stage"
use "walk_controls"
dark_stage()

# a pale corner behind the shapes: two walls the bulb's light bounces off, so the sides it can't see
# straight on are lit a little by the walls instead of staying black (the light cache)
let wall = material(color: rgb(0.8, 0.78, 0.74), roughness: 0.9)
box size: vec(5, 2.6, 0.1), at: vec(0.2, 1.3, -2.35), material: wall
box size: vec(0.1, 2.6, 5), at: vec(-2.35, 1.3, 0.2), material: wall

# what the light falls on
let clay = material(color: rgb(0.72, 0.7, 0.66), roughness: 0.6)
sphere(0.35, at: vec(-0.9, 0.35, 0), material: clay)
box size: vec(0.6, 0.6, 0.6), at: vec(0.7, 0.3, -0.3), turn: 30 deg, material: clay
cylinder(0.12, 1.6, at: vec(0.1, 0.8, -1.1), material: clay)
cone(0.3, 0.7, at: vec(0.9, 0.35, 0.9), material: clay)

# the bare bulb: 800 lumens the colour of the midday sun (5500 K: white with a touch of warmth; a
# household bulb is 2700 K, orange), and a small glowing ball to show where it is (inside the bulb's
# own size, so it never shades its own light)
let bulb = light(at: vec(-1.6, 1.2, 1.2), lumens: 800, kelvin: 5500, radius: 0.04)
let glass = sphere(0.03, at: vec(-1.6, 1.2, 1.2), material: material(color: kelvin(5500), glow: 600), collide: no)
# round the shapes in 16 seconds, rising and falling a little, and round again with no jolt
clip bulb, loop: yes
  key 0 s, at: vec(-1.6, 1.2, 1.2)
  key 4 s, at: vec(1.8, 0.9, 1.4)
  key 8 s, at: vec(1.8, 1.5, -1.8)
  key 12 s, at: vec(-1.6, 1.0, -1.6)
  key 16 s, at: vec(-1.6, 1.2, 1.2)
clip glass, loop: yes
  key 0 s, at: vec(-1.6, 1.2, 1.2)
  key 4 s, at: vec(1.8, 0.9, 1.4)
  key 8 s, at: vec(1.8, 1.5, -1.8)
  key 12 s, at: vec(-1.6, 1.0, -1.6)
  key 16 s, at: vec(-1.6, 1.2, 1.2)

walk_controls(vec(0, 0, 4.2), look_at: vec(0, 0.5, 0))
# the film camera where the player starts, at their eye (a film picture of the room matches the first view)
camera at: vec(0, 1.65, 4.2), look_at: vec(0, 0.5, 0)
