# 14. Neon Rain — WATCHED. Thirteenth Alley, three hundred years on. Night, rain, neon.
use "ardane_common"
title "14 · Neon Rain"
mode "movie"

let wet = material(like: "concrete", color: rgb(0.08, 0.08, 0.1), roughness: 0.08)
let chrome_wall = material(like: "steel", color: rgb(0.3, 0.32, 0.36), roughness: 0.35)
alley(chrome_wall, wet, length: 30, width: 4, height: 28)
ground 120, material: wet
# cables, vents and towers rising out of sight
for z from 0 to -26 by -2.5
  cylinder 0.04, 30, at: vec(-2.2, 14, z), material: "rubber", collide: no
  box size: vec(0.6, 0.4, 1.2), at: vec(2.0, 3 + (z % 7), z), material: "steel", collide: no
neon_sign vec(-2.15, 6, -6), vec(0.05, 0.6, 2.4), rgb(1.0, 0.1, 0.7), facing: 90 deg
neon_sign vec(2.15, 9, -10), vec(0.05, 1.8, 0.5), rgb(0.1, 0.9, 1.0), facing: 90 deg
neon_sign vec(-2.15, 13, -16), vec(0.05, 0.5, 3.2), rgb(0.1, 0.9, 1.0), facing: 90 deg
neon_sign vec(2.15, 4.2, -20), vec(0.05, 0.4, 1.6), rgb(1.0, 0.3, 0.1), facing: 90 deg
# the face: WANTED: ARDANE, ten metres high on the end wall
let face = hologram(vec(0, 12, -27.6), vec(8, 10, 0.05), rgb(0.3, 0.8, 1.0))
let banner = hologram(vec(0, 5.6, -27.5), vec(8, 1.2, 0.05), rgb(1.0, 0.1, 0.25))
# the eyes and mouth, darker, so it reads as a face
for each e in [vec(-1.6, 13.4, -27.5), vec(1.6, 13.4, -27.5)]
  box size: vec(1.4, 0.6, 0.05), at: e, material: material(color: rgb(0, 0, 0)), collide: no
box size: vec(2.6, 0.4, 0.05), at: vec(0, 9.8, -27.5), material: material(color: rgb(0, 0, 0)), collide: no
for i from 0 to 5
  drone vec(random(-1.5, 1.5), random(6, 14), random(-24, -4))
rain_streaks vec(0, 0, -10), count: 260, spread: 2, height: 10

let milo = hero(vec(0, 0, -2), facing: 180 deg)
let nia = someone(vec(-0.9, 0, -1.4), height: 1.62, shirt: cloth(0.15, 0.45, 0.42), skin: skin_deep, facing: 180 deg)
let oren = someone(vec(1.0, 0, -1.2), height: 1.92, shirt: cloth(0.85, 0.7, 0.3), trousers: linen, skin: skin_deep, facing: 180 deg)
let sela = someone(vec(0.3, 0, -0.4), height: 1.68, shirt: cloth(0.55, 0.62, 0.4), skin: skin_light, facing: 180 deg)
let robot = pip(vec(0.6, 0, -16), facing: 0 deg)
portal(vec(0, 1.5, 1.6), size: 1.3)
relic_orbit(milo, recall("relics", 4))

sound "rain", volume: 1
sound "synth", at: vec(2, 2, -12), volume: 0.6
sound "drones", volume: 0.5
sound "hum", volume: 0.3
room 0.6, echo: 0.4
sky "physical", haze: 10, stars: 0
sun elevation: -12 deg, lux: 0.05
fog 0.035, glow: 0.7, color: rgb(0.7, 0.75, 0.9), from: vec(-2, 0, -28), to: vec(2, 28, 2)
look "neon", contrast: 1.2, bloom: 0.35, grain: 0.03, bars: 2.39

camera at: vec(0.4, 1.4, 1), look_at: vec(0, 6, -27), lens: 24 mm
shot "out of the light", 10 s, from: {at: vec(0.3, 1.3, -5), look_at: vec(0, 1.4, 1.5), lens: 28 mm, f_stop: 2}, to: {at: vec(0.2, 1.4, -4), look_at: vec(0, 1.4, -1), lens: 32 mm, f_stop: 2}, fade_in: 1 s
shot "his own face", 16 s, from: {at: vec(0.6, 0.5, 0.5), look_at: vec(0, 10, -27), lens: 18 mm}, to: {at: vec(0.4, 0.8, -1), look_at: vec(0, 12, -27), lens: 20 mm}, ease: "in_out"
shot "a small robot", 14 s, from: {at: vec(1.2, 0.4, -6), look_at: vec(0.6, 0.4, -14), lens: 45 mm, f_stop: 1.8}, to: {at: vec(0.9, 0.5, -5), look_at: vec(0.6, 0.4, -7), lens: 50 mm, f_stop: 1.8}
shot "trending", 14 s, from: {at: vec(0, 0.6, -6), look_at: vec(0, 1.4, -2), lens: 28 mm}, to: {at: vec(0, 1.0, -7), look_at: vec(0, 3, -2), lens: 24 mm}, fade_out: 2 s
render file: "ardane_14_nexus.png", quality: "good", width: 1280, at: 16 s

task
  wait 2 s
  say "", "They step out into rain that tastes of metal."
  say "", "The same alley. Three hundred years on."
  wait 1 s
  for each p in [milo, nia, oren, sela]
    p.look_at = vec(0, 12, -27)
  say "", "Ten metres high on the wall, a face made of light. It's his."
  say "", "WANTED: ARDANE."
  say "Oren", "...Is that a god?"
  say "Nia", "It's him, Oren. It's just him, very big."
  # Pip rolls up through the puddles
  let start = time()
  every 1 / 30 s
    let u = clamp((time() - start) / 5, 0, 1)
    pip_move(robot, lerp(vec(0.6, 0, -16), vec(0.3, 0, -3.2), ease(u, "smooth")), facing: 180 deg)
  wait 5 s
  for each p in [milo, nia, oren, sela]
    p.look_at = vec(0.3, 0.3, -3.2)
  sound "click", "plastic", at: vec(0.3, 0.4, -3.2)
  say "Robot", "ERROR 418. I am a teapot."
  pause 1 s
  say "Robot", "Joking. I am Pip. You are trending."
  say "Pip", "Helix offers nine thousand credits for the boy. I have decided I like you better than nine thousand credits."
  say "Pip", "This is a rounding error in my favour. Follow me, please. Mind the drones. They do not have a sense of humour."
  next_scene "ardane_15_undercity", delay: 2 s
