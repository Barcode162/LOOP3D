# 15. Static — PLAYED. The Undercity market. Night, rain.
use "ardane_common"
title "15 · Static"
mode "game"

let wet = material(like: "concrete", color: rgb(0.1, 0.1, 0.11), roughness: 0.12)
ground 80, material: wet
# a low concrete sky: the city's underside, pipes, steam
box size: vec(60, 1, 60), at: vec(0, 9, 0), material: material(like: "concrete", color: rgb(0.15, 0.15, 0.16))
for x from -20 to 20 by 4
  cylinder 0.3, 60, at: vec(x, 8.2, 0), rotation: vec(0, 90 deg, 0), material: "rust", collide: no
for each p in [vec(-12, 0, -12), vec(12, 0, -12), vec(-12, 0, 12), vec(12, 0, 12)]
  box size: vec(1.4, 9, 1.4), at: p + vec(0, 4.5, 0), material: "concrete"
# the stalls: tarps, counters, a lamp each, screens and smoke
let stalls = []
seed(15)
for i from 0 to 13
  let a = i * tau / 14
  let at = vec(cos(a) * 9, 0, sin(a) * 9)
  let face = -a + 270 deg
  box size: vec(2.4, 1.0, 1.0), at: at + vec(0, 0.5, 0), turn: face, material: ["rust", "old wood", "plastic"].pick()
  box size: vec(2.8, 0.04, 1.8), at: at + vec(0, 2.4, 0), turn: face, tilt: 10 deg, material: cloth(random(0.1, 0.9), random(0.1, 0.5), random(0.2, 0.9)), collide: no
  light at + vec(0, 2.1, 0), lumens: 500, color: [rgb(1, 0.6, 0.3), rgb(1, 0.2, 0.6), rgb(0.3, 0.9, 1)].pick(), radius: 0.1
  if chance(50%)
    box size: vec(0.6, 0.4, 0.04), at: at + vec(0, 1.5, 0), turn: face, material: "screen", collide: no
  stalls.push(at)
# strings of bulbs across the square
for i from 0 to 23
  let a = i * tau / 24
  sphere 0.05, at: vec(cos(a) * 6, 4.5 + 0.3 * sin(i * 1.7), sin(a) * 6), material: material(color: rgb(0, 0, 0), glow: kelvin(2200) * 6000), collide: no
let cookfire = vec(-3, 0, 2)
cylinder 0.4, 0.5, at: cookfire + vec(0, 0.25, 0), material: "rust"
sphere 0.18, at: cookfire + vec(0, 0.6, 0), scale: vec(1, 1.6, 1), material: "flame", collide: no
light cookfire + vec(0, 0.8, 0), lumens: 1500, kelvin: 1800, radius: 0.15
sound "fire", at: cookfire, volume: 0.6
# Juno's terminal
let terminal = vec(4, 0, -3)
box size: vec(1.6, 0.9, 0.7), at: terminal + vec(0, 0.45, 0), material: "steel"
let screen = box(size: vec(1.2, 0.7, 0.04), at: terminal + vec(0, 1.3, -0.2), tilt: -10 deg, material: "screen", collide: no)
light terminal + vec(0, 1.3, 0.3), lumens: 300, color: rgb(0.3, 0.9, 1.0), radius: 0.3
rain_streaks vec(0, 0, 14), count: 200, spread: 8, height: 8

let juno = someone(terminal + vec(0, 0, -1), height: 1.72, shirt: cloth(0.1, 0.1, 0.12), skin: skin_deep, facing: 0 deg)
let crowd = []
seed(151)
repeat 18 times
  crowd.push(someone(vec(random(-7, 7), 0, random(-7, 7)), shirt: cloth(random(0.05, 0.4), random(0.05, 0.3), random(0.1, 0.5))))
every 3 s
  let c = crowd.pick()
  c.walk_to = stalls.pick() * 0.8
let nia = someone(vec(-1, 0, 7), height: 1.62, shirt: cloth(0.15, 0.45, 0.42), skin: skin_deep, facing: 180 deg)
let robot = pip(vec(1, 0, 6))
relic_orbit(nothing, recall("relics", 4))

sound "crowd", volume: 0.5
sound "rain", volume: 0.5
sound "synth", at: stalls[3], volume: 0.5
sound "hum", at: terminal, volume: 0.4
room 0.5, echo: 0.3
sky "none"
fog 0.03, glow: 0.6, color: rgb(0.8, 0.8, 0.85)
look "neon", contrast: 1.15, bloom: 0.3, grain: 0.04, bars: 2.39
camera at: vec(0, 1.6, 10), look_at: vec(0, 1.4, 0), lens: 28 mm
render file: "ardane_15_undercity.png", quality: "good", width: 1280, at: 5 s

task
  wait 1 s
  say "", "The Undercity. Its people call it Static. Everything here was built by hand, and everything works."
  for each c in crowd
    c.look_at = player() + vec(0, 1.5, 0)
  say "", "Every face in the market turns toward the boy from the poster."
  say "Static", "That's the Helix poster kid. Who brought a cop's dream down here?"
  pip_move(robot, vec(0, 0, 4.4), facing: 180 deg)
  say "Pip", "They are ninety-eight percent not cops. I checked. The other two percent is mostly Oren."
  for each c in crowd
    c.look_at = nothing
  go_and_use(terminal, "A woman with a shaved head is waiting at a terminal.")
  juno.look_at = player() + vec(0, 1.5, 0)
  say "Juno-7", "You're the Ardane. Read this. Nobody alive can."
  say "", "Code on the screen, three hundred years old, written by hand."
  say "", "He reads it as if it were his grandmother's handwriting."
  screen.material = material(color: rgb(0, 0, 0), glow: rgb(0.3, 1.0, 0.6) * 300)
  say "Juno-7", "Ada Ardane wrote the Mercy Protocol. One program. It stopped every drone in the war at once."
  say "Juno-7", "It ended the war. Helix deleted her and took the credit."
  say "Juno-7", "The last copy is in the archive core at the top of the Helix Tower. They wipe it at dawn."
  nia.walk_to = player() + vec(-0.8, 0, 0.8)
  wait 2 s
  say "Nia", "Milo. Can we do it?"
  say "Milo", "Probability of success: forty-one percent."
  say "", "His eyes glow faintly. He doesn't notice. Nia does."
  say "Nia", "...That's not how you talk."
  say "Pip", "It is how I talk. I don't recommend it."
  next_scene "ardane_16_core", delay: 2 s
