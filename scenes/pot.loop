# pot · a steel cooking pot with a glass lid and two loop handles
# pot(at, across, height) stands it on `at`: `across` wide (0.22 m), `height` tall (0.14 m) under its lid.
#
# kind: model
# place: pot(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: pot, saucepan, stock pot, kitchen, cookware, loft
# size: hand
# seeds: none, the same every time
to pot(at: vec(0, 0, 0), across: 0.22, height: 0.14, turn: 0)
  let r = across / 2
  let g = group(at: at, turn: turn)
    lathe(profile: [vec(0, 0), vec(r, 0), vec(r, height), vec(r - 0.004, height), vec(r - 0.004, 0.004), vec(0, 0.004)], segments: 32, material: material(like: "steel", roughness: 0.2), collide: no)
    lathe(profile: [vec(0, height + 0.025), vec(r * 0.6, height + 0.018), vec(r + 0.004, height), vec(0, height + 0.003)], segments: 32, material: "glass", collide: no)
    sphere(radius: 0.014, at: vec(0, height + 0.035, 0), scale: vec(1, 0.6, 1), material: "black", sides: 16, collide: no)
    for each s in [-1, 1]
      ring(radius: 0.022, thickness: 0.005, at: vec(s * (r + 0.014), height - 0.02, 0), rotation: vec(0, 0, 90 deg), material: "steel", sides: 20)
  return g
