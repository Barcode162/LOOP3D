# lounge_chair · a mid-century lounge chair: a walnut shell holding leather cushions, tilted back on a five-star base
# lounge_chair(at, turn, leather, wood) stands it on `at`, facing -z: 0.84 m wide, 0.85 m tall at the back.
#
# kind: model
# place: lounge_chair(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: lounge chair, armchair, recliner, living, reading, loft
# size: chair
# seeds: none, the same every time
to lounge_chair(at: vec(0, 0, 0), turn: 0, leather: material(like: "leather", color: rgb(0.06, 0.045, 0.035)), wood: "walnut")
  let g = group(at: at, turn: turn)
    for each i in range(0, 5, 1)
      let a = i * 72 deg
      box size: vec(0.04, 0.025, 0.36), at: vec(sin(a) * 0.17, 0.05, cos(a) * 0.17), turn: a, material: "aluminium", round: 0.01, collide: no
    cylinder(radius: 0.03, height: 0.28, at: vec(0, 0.19, 0), material: "black", sides: 16, collide: no)
    box size: vec(0.78, 0.04, 0.62), at: vec(0, 0.36, -0.02), tilt: -8 deg, material: wood, round: 0.02, steps: 2
    box size: vec(0.68, 0.11, 0.56), at: vec(0, 0.43, -0.04), tilt: -8 deg, material: leather, round: 0.05, steps: 3
    box size: vec(0.8, 0.6, 0.04), at: vec(0, 0.68, 0.3), tilt: -18 deg, material: wood, round: 0.02, steps: 2
    box size: vec(0.7, 0.55, 0.1), at: vec(0, 0.7, 0.24), tilt: -18 deg, material: leather, round: 0.05, steps: 3
    for each s in [-1, 1]
      box size: vec(0.07, 0.05, 0.5), at: vec(s * 0.38, 0.57, 0.0), tilt: -8 deg, material: wood, round: 0.02, collide: no
      box size: vec(0.09, 0.05, 0.42), at: vec(s * 0.38, 0.61, 0.0), tilt: -8 deg, material: leather, round: 0.024, collide: no
  return g
