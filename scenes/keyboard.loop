# keyboard · a low keyboard and a mouse beside it, on a felt mat
# keyboard(at, turn) lays them on `at`, the keys facing a sitter at -z: the mat 0.6 x 0.3 m.
#
# kind: model
# place: keyboard(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: keyboard, mouse, computer, desk, work, loft
# size: hand
# seeds: none, the same every time
to keyboard(at: vec(0, 0, 0), turn: 0)
  let g = group(at: at, turn: turn)
    box size: vec(0.6, 0.003, 0.3), at: vec(0, 0.0015, 0), material: material(like: "wool", color: rgb(0.25, 0.25, 0.26), roughness: 1), collide: no
    box size: vec(0.36, 0.014, 0.12), at: vec(-0.07, 0.01, 0), tilt: 2 deg, material: "aluminium", round: 0.004, collide: no
    box size: vec(0.34, 0.003, 0.1), at: vec(-0.07, 0.0175, 0), tilt: 2 deg, material: material(color: rgb(0.85, 0.85, 0.84), roughness: 0.5), collide: no
    sphere(radius: 0.032, at: vec(0.22, 0.01, 0), scale: vec(0.95, 0.4, 1.6), material: material(color: rgb(0.88, 0.88, 0.87), roughness: 0.4), sides: 14, collide: no)
  return g
