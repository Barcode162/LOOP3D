# tea_towel · a striped cotton tea towel hung over a rail or an oven handle
# tea_towel(at, turn, stripe) hangs it with `at` the middle of the rail it hangs on, facing -z: 0.24 m wide, hanging 0.3 m.
#
# kind: model
# place: tea_towel(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: tea towel, cloth, kitchen, linen, loft
# size: hand
# seeds: none, the same every time
to tea_towel(at: vec(0, 0, 0), turn: 0, stripe: rgb(0.12, 0.2, 0.4))
  let cotton = material(like: "linen", color: rgb(0.88, 0.86, 0.8))
  let band = material(like: "linen", color: stripe)
  let g = group(at: at, turn: turn)
    box size: vec(0.24, 0.3, 0.006), at: vec(0, -0.14, -0.014), rotation: vec(0, 3 deg, 0), material: cotton, round: 0.003, collide: no
    box size: vec(0.24, 0.12, 0.006), at: vec(0, -0.05, 0.012), rotation: vec(0, -4 deg, 0), material: cotton, round: 0.003, collide: no
    for each y in [-0.23, -0.21]
      box size: vec(0.242, 0.01, 0.007), at: vec(0, y, -0.019), rotation: vec(0, 3 deg, 0), material: band, collide: no
    box size: vec(0.24, 0.02, 0.02), at: vec(0, 0.005, 0), material: cotton, round: 0.009, collide: no
  return g
