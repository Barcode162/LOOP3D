# monitor · a computer monitor on a slim stand, its screen on with a soft working glow
# monitor(at, turn, size, on) stands it on `at`, its screen towards -z: `size` the diagonal in inches (27).
#
# kind: model
# place: monitor(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: monitor, screen, computer, desk, work, loft
# size: hand
# seeds: none, the same every time
to monitor(at: vec(0, 0, 0), turn: 0, size: 27, on: yes)
  let w = size * 0.0254 * 0.872
  let h = size * 0.0254 * 0.49
  let face = material(color: rgb(0.02, 0.02, 0.022), roughness: 0.1)
  if on
    face = material(color: rgb(0.02, 0.02, 0.022), roughness: 0.1, glow: rgb(0.75, 0.8, 0.9) * 25)
  let g = group(at: at, turn: turn)
    box size: vec(0.24, 0.01, 0.18), at: vec(0, 0.005, 0.03), material: "aluminium", round: 0.004, collide: no
    box size: vec(0.05, 0.28, 0.02), at: vec(0, 0.15, 0.08), tilt: 8 deg, material: "aluminium", collide: no
    box size: vec(w, h, 0.02), at: vec(0, 0.12 + h / 2, 0.05), material: "black", round: 0.003, collide: no
    box size: vec(w - 0.012, h - 0.012, 0.002), at: vec(0, 0.12 + h / 2, 0.039), material: face, collide: no
  return g
