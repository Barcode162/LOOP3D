# book_stack · books lying flat in a stack, the biggest at the bottom, as on a coffee table or a shelf
# book_stack(at, turn, count, seed) stacks `count` (3) books on `at`: art books 0.25 to 0.32 m across.
#
# kind: model
# place: book_stack(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: books, coffee table books, stack, shelf, living, loft
# size: hand
# seeds: any whole number
to book_stack(at: vec(0, 0, 0), turn: 0, count: 3, seed: 1)
  let covers = [rgb(0.85, 0.82, 0.74), rgb(0.12, 0.12, 0.12), rgb(0.55, 0.2, 0.12), rgb(0.2, 0.3, 0.35), rgb(0.7, 0.6, 0.4)]
  let y = 0
  let g = group(at: at, turn: turn)
    for each i in range(0, count, 1)
      let w = 0.32 - i * 0.025 - (noise(seed, i, 0.3) + 1) * 0.01
      let d = 0.25 - i * 0.02
      let t = 0.025 + (noise(seed * 2, i, 0.7) + 1) * 0.008
      let k = floor((noise(seed * 3, i * 1.7, 0.2) + 1) * 2.49)
      box size: vec(w, t, d), at: vec(0, y + t / 2, 0), turn: noise(seed, i * 2.1, 0.9) * 0.15, material: material(like: "paper", color: covers[max(0, min(4, k))], roughness: 0.6), round: 0.002, collide: no
      y += t
  return g
