# 19. The Scar — PLAYED. The Hollow's edge, then Thirteenth Alley at night.
use "ardane_common"
title "19 · The Scar"
mode "game"

# ---- the Hollow, empty and going grey
ground 400, material: material(like: "marble", color: rgb(0.7, 0.7, 0.68))
seed(19)
repeat 40 times
  let a = random(0, tau)
  let d = random(10, 50)
  let h = random(6, 24)
  box size: vec(3, h, 3), at: vec(cos(a) * d, h / 2, sin(a) * d), turn: -a, material: material(like: "marble", color: rgb(0.75, 0.74, 0.7))
# the door no one built: a small wooden door in a frame, alone in the square
let door_at = vec(0, 0, -14)
box size: vec(1.3, 2.4, 0.15), at: door_at + vec(0, 1.2, 0), material: plaster
let little_door = box(size: vec(0.9, 2.0, 0.06), at: door_at + vec(0, 1.0, 0.08), material: "old wood")
let door_light = light(door_at + vec(0, 1.0, 0.6), lumens: 0, kelvin: 2000, radius: 0.3)
# one red thread glowing in the grey
let thread = ring(0.05, 0.008, at: vec(0, 1.0, 0), material: material(color: rgb(0, 0, 0), glow: rgb(1, 0.1, 0.08) * 3000), collide: no)
every 1 / 30 s
  thread.position = player() + vec(0.25, 1.0, 0)

# ---- Thirteenth Alley, far away, where he wakes
let alley_at = vec(300, 0, 0)
let wet = material(like: "concrete", color: rgb(0.25, 0.25, 0.27), roughness: 0.25)
box size: vec(0.5, 9, 18), at: alley_at + vec(-1.95, 4.5, -7), material: "brick"
box size: vec(0.5, 9, 18), at: alley_at + vec(1.95, 4.5, -7), material: "brick"
box size: vec(3.4, 0.1, 18), at: alley_at + vec(0, -0.05, -7), material: wet
box size: vec(4, 9, 0.5), at: alley_at + vec(0, 4.5, -16), material: "brick"
street_lamp alley_at + vec(-1.4, 0, 1), temp: 1900, lumens: 2500
let nia = someone(alley_at + vec(-0.8, 0, -4.4), height: 1.62, shirt: cloth(0.15, 0.45, 0.42), skin: skin_deep, facing: 90 deg)
let oren = someone(alley_at + vec(0.9, 0, -4.6), height: 1.92, shirt: cloth(0.85, 0.7, 0.3), trousers: linen, skin: skin_deep, facing: 270 deg)
let sela = someone(alley_at + vec(0, 0, -5.6), height: 1.68, shirt: cloth(0.55, 0.62, 0.4), skin: skin_light, facing: 0 deg)
for each p in [nia, oren, sela]
  p.sitting = yes
  p.look_at = alley_at + vec(0, 0.3, -4.6)
let rain = sound("rain", at: alley_at, volume: 0)

sound "wind", volume: 0.2
room 0.9, echo: 0.6
sky "color", color: rgb(0.8, 0.8, 0.78), nits: 1500
sun elevation: 60 deg, toward: 0 deg, lux: 20000
look "bleach", saturation: 0.3, contrast: 0.95, bars: 2.39
camera at: vec(0, 1.6, 6), look_at: vec(0, 1.4, 0), lens: 28 mm
render file: "ardane_19_scar.png", quality: "good", width: 1280, at: 4 s

task
  wait 2 s
  say "", "The city is empty. The colour is draining out of it, like a photograph left in the sun."
  say "", "Only one thing still has colour: a red thread on his wrist."
  go_and_use(door_at + vec(0, 0, 1), "There's a door no one built. Small. Wooden. Real.", within: 2.5)
  door_light.lumens = 400
  sound "click", "wood", at: door_at
  say "", "It's the door of the room above the laundry. Behind it, he can hear the machines."
  say "", "The Knot is warm. And there are voices."
  say "Nana", "(far away) Little lamp..."
  say "Nia", "(laughing, somewhere) You hold a rope like it owes you money!"
  say "Pip", "(a crackle) ERROR 418..."
  say "Bea", "(very small) You're the big one."
  little_door.visible = no
  go_and_use(door_at, "Walk through the little door.", within: 1.5)
  # the alley, in the rain
  sound "whoosh", at: player()
  move_player(alley_at + vec(0, 0, -4.6), look_at: alley_at + vec(0, 1.0, -5.6))
  look "noir", contrast: 1.15, saturation: 0.7, grain: 0.04, bars: 2.39
  sky "physical", haze: 10, stars: 0
  sun elevation: -12 deg, lux: 0.05
  rain.volume = 1
  room 0.5, echo: 0.35
  say "", "Rain on his face. Brick. The smell of the laundry vents."
  say "", "He's lying in Thirteenth Alley. There's a streak of white in his hair. His left hand won't stop shaking."
  say "", "Nia, Oren and Sela are kneeling over him. Pip isn't."
  for each p in [nia, oren, sela]
    p.look_at = player() + vec(0, 0.4, 0)
  say "Nia", "Tell us our names."
  pause 2 s
  say "Milo", "Nia."
  pause 1 s
  say "Milo", "Oren. Sela."
  pause 2 s
  say "Milo", "Pip."
  pause 2 s
  say "Milo", "Me. Milo Ardane."
  say "", "Nia puts her forehead against his and breathes out for what feels like the first time in days."
  let c = choose("Above the rooftops, something is wrong with the sky.", ["Go home and apologise", "Stay and get ready"])
  remember "apologised", c == 0
  if c == 0
    say "", "He runs up the laundry stairs. Rosa opens the door before he knocks. He says sorry. She says nothing. She holds him so hard it hurts."
    say "Nana", "There he is."
  else
    say "Oren", "Then we get ready. Together, this time."
    say "", "He looks up at the window above the laundry. The lamp is on."
  say "", "And above Calder Row, the sky begins to tear."
  next_scene "ardane_20_convergence", delay: 2 s
