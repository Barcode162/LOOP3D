# ladder_shelf · a leaning ladder bookshelf: two rails against the wall and shelves that grow deeper towards the floor
# ladder_shelf(at, turn, height, width, wood) stands its feet on `at` with its back leaning on a wall at +z: `height` (1.8 m), `width` (0.6 m), five shelves.
#
# kind: model
# place: ladder_shelf(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: ladder shelf, leaning shelf, bookshelf, living, loft
# size: chair
# seeds: none, the same every time
to ladder_shelf(at: vec(0, 0, 0), turn: 0, height: 1.8, width: 0.6, wood: "oak")
  let lean = 10 deg
  let g = group(at: at, turn: turn)
    for each s in [-1, 1]
      box size: vec(0.035, height, 0.035), at: vec(s * width / 2, height / 2 * cos(lean), height / 2 * sin(lean)), tilt: 0 - lean, material: wood, round: 0.006
    for each i in range(0, 5, 1)
      let y = 0.15 + i * (height - 0.3) / 4
      let d = 0.38 - i * 0.065
      box size: vec(width - 0.035, 0.022, d), at: vec(0, y, y * tan(lean) + 0.02 - d / 2 + 0.03), material: wood, round: 0.004
  return g
