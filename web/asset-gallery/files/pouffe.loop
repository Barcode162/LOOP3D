to pouffe(at: vec(0, 0, 0), turn: 0)
  let assembly = group(at: at, turn: turn)
    let shape0 = sphere(0.5, at: vec(0, 0.2, 0), material: material(like: "fabric", color: rgb(0.82, 0.73, 0.58)))
    shape0.scale = vec(0.64, 0.4, 0.64)
  return assembly
