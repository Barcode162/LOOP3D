to computer_mouse(at: vec(0, 0, 0), turn: 0)
  let assembly = group(at: at, turn: turn)
    let shape0 = sphere(0.5, at: vec(0, 0.02, 0), material: material(like: "plastic", color: rgb(0.065, 0.065, 0.07)))
    shape0.scale = vec(0.065, 0.04, 0.11)
    let shape2 = sphere(0.5, at: vec(0, 0.0405, -0.013), material: "iron")
    shape2.scale = vec(0.009, 0.009, 0.023)
  return assembly
