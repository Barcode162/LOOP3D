let piano_playing = -1     # the song playing now (a number in piano_songs), or -1
let piano_run = 0          # bumped at every start and stop, so an old song's task knows to end
let piano_asking = no

# the sheet music was tapped: stop the song playing, or ask which one
to piano_sheet()
  if piano_playing >= 0
    piano_stop()
  else
    let titles = []
    for each s in piano_songs
      titles.push(s.title)
    titles.push("Not now")
    piano_asking = yes
    ask("Sheet music: pick a song", titles)

to piano_stop()
  piano_run += 1
  if piano_playing >= 0
    piano_playing = -1
    emit "quiet"

to piano_start(n)
  piano_stop()
  let song = piano_songs[n]
  let notes = song.notes.join("").split(";")
  let run = piano_run
  piano_playing = n
  music_bpm = song.bpm
  emit "music"
  task
    wait 0.4 s
    let began = time()
    let at = 0
    while run == piano_run and at < notes.length - 1
      let f = notes[at].split(",")
      let due = began + number(f[0]) / 100
      if due > time()
        wait due - time()
      if run != piano_run
        break
      let hard = number(f[3]) / 127
      let i = number(f[1]) - 21
      piano_last = piano_note_name(i + 21)
      note "keys", piano_last, volume: piano_volume(hard), length: number(f[2]) / 100
      light_key(i)
      at += 1
    if run == piano_run
      wait 1 s
    if run == piano_run
      piano_stop()

when "choice"
  if piano_asking
    piano_asking = no
    if event >= 0 and event < piano_songs.length
      piano_start(event)
