# The piano in the bar: tap the keys to play a note, tap the sheet music to pick a song.
# bar.loop pastes this at its end, after `use "bar_use_common"` (the importer adds the line).
# Written by hand, not by tools/import_bar.py.
#
# What the old bar did (bar/piano.cpp), and what is brought over:
# - The old bar played the piano only SITTING on the bench, with an on-screen keyboard (88 keys,
#   a window of 7 to 24 whites, a tap higher up the key was softer, lower down louder). It never
#   took a tap on the model's own keys. Here the keys are tapped on the model, and the same rule
#   holds: a tap on the keys plays only while the player sits on the bench; standing, the tap
#   falls through to bar_use_common, which sits the player on the bench.
# - A pressed key lit up (a coloured glowing box on the key, bass blue to treble pink); the model's
#   keys never moved. Here the same: a thin glowing box over the key for 0.15 s.
# - The sheet music (the kind's "piano-songs" use) opened the song list; a song played from the
#   piano's own spot. Seven of the old ten songs came over, as notes and times written below (the
#   old bar kept them as .mid files from the Mutopia Project, see assets/midi/CREDITS.md in the old
#   repo). The three under CC BY-SA (Moonlight Sonata, Nocturne Op 9 No 2, Sonata Facile) are left
#   out until the project's licence is decided; the seven here are public domain.
# - Not brought: the strings that glow and shake, the rising sparks, the live-note sharing for
#   other players, the pedal, your own .mid files.

let piano_at = vec(-8, 0.3, 5.6)       # where the thing "piano" stands (the old bar's place)
let piano_yaw = radians(104.897)       # how far it is turned
let piano_reach = 2                    # metres from the eye for a tap on the keys
let piano_sheet_reach = 3              # the same for the sheet music
let piano_key_glow = 0.15 s            # how long a pressed key stays lit

# ---- the keyboard, in the piano's own space (from the old piano.cpp: keys along x, bass at -x,
# the player at -z). 88 keys from A0 (MIDI 21) to C8 (108): 52 white, each 0.02345 m wide; a black
# key stands on the line between its two white neighbours.
let key_w = 0.02345
let keys_start = -52 * key_w / 2
let white_top = 0.727      # a white key's middle height, and its middle and half depth
let white_z = -0.078
let white_half = 0.076
let black_top = 0.738
let black_z = -0.055
let black_half = 0.0475
let key_is_black = []
let key_x = []
let white_keys = []
let whites_made = 0
for i from 0 to 87
  let n = (i + 9) % 12
  let black = n == 1 or n == 3 or n == 6 or n == 8 or n == 10
  key_is_black.push(black)
  if black
    key_x.push(keys_start + whites_made * key_w)
  else
    key_x.push(keys_start + whites_made * key_w + key_w / 2)
    white_keys.push(i)
    whites_made += 1

# the sheet music's box (the old kind's "uses" box), in the piano's space
let sheet_low = vec(-0.13403, 0.87, -0.28085)
let sheet_high = vec(0.36597, 1.17, 0.21915)

to piano_to_local(p)
  let d = p - piano_at
  let c = cos(piano_yaw)
  let s = sin(piano_yaw)
  return vec(d.x * c - d.z * s, d.y, d.x * s + d.z * c)

to piano_to_world(l)
  let c = cos(piano_yaw)
  let s = sin(piano_yaw)
  return vec(piano_at.x + l.x * c + l.z * s, piano_at.y + l.y, piano_at.z - l.x * s + l.z * c)

# the name `note` takes for a MIDI key number, like "C4" (60) or "C#5" (73)
let note_names = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
to piano_note_name(midi)
  return note_names[midi % 12] + text(floor(midi / 12) - 1)

# the key under a point in the piano's space and how hard it is struck: {key: 0..87, hard: 0..1},
# or nothing. Black keys first (they sit on the back part of the whites), as the old code chose;
# the old code's hardness: a tap nearer the player is louder.
to piano_key_at(l)
  let margin = 0.03
  if l.x < keys_start - margin or l.x > -keys_start + margin
    return nothing
  if l.z < white_z - white_half - margin or l.z > white_z + white_half + margin
    return nothing
  if l.y < white_top - 0.07 or l.y > white_top + 0.07
    return nothing
  let back = white_z + white_half
  let along = clamp((back - l.z) / (2 * white_half), 0, 1)    # 0 at the back, 1 at the front
  if along < 0.62
    for i from 0 to 87
      if key_is_black[i] and abs(l.x - key_x[i]) < key_w * 0.3
        return {key: i, hard: clamp(0.12 + 0.95 * along / 0.62, 0.1, 1)}
  let w = clamp(floor((l.x - keys_start) / key_w), 0, 51)
  return {key: white_keys[w], hard: clamp(0.12 + 0.95 * along, 0.1, 1)}

# ---- a pressed key shows: a thin glowing box over it for a moment (a small pool, reused)
let key_glow_colours = []
for h from 0 to 5
  let t = h / 5
  key_glow_colours.push(material(color: rgb(0.3 + 0.7 * t, 0.45, 1 - 0.6 * t), glow: 30))
let white_lights = []
let black_lights = []
let white_stamp = [0, 0, 0, 0, 0, 0]    # when each pooled box was last lit
let black_stamp = [0, 0, 0, 0, 0, 0]
for h from 0 to 5
  let w = box(size: vec(0.0215, 0.008, 0.152), turn: piano_yaw, collide: no, material: key_glow_colours[0])
  w.visible = no
  white_lights.push(w)
  let b = box(size: vec(0.012, 0.012, 0.095), turn: piano_yaw, collide: no, material: key_glow_colours[0])
  b.visible = no
  black_lights.push(b)
let white_next = 0
let black_next = 0

to light_key(i)
  let hue = key_glow_colours[round(i / 87 * 5)]
  let stamp = time()
  if key_is_black[i]
    let slot = black_next
    black_next = (black_next + 1) % 6
    let lamp = black_lights[slot]
    lamp.position = piano_to_world(vec(key_x[i], black_top, black_z))
    lamp.material = hue
    lamp.visible = yes
    black_stamp[slot] = stamp
    after piano_key_glow
      if black_stamp[slot] == stamp
        lamp.visible = no
  else
    let slot = white_next
    white_next = (white_next + 1) % 6
    let lamp = white_lights[slot]
    lamp.position = piano_to_world(vec(key_x[i], white_top, white_z))
    lamp.material = hue
    lamp.visible = yes
    white_stamp[slot] = stamp
    after piano_key_glow
      if white_stamp[slot] == stamp
        lamp.visible = no

# how loud a key struck at `hard` (0..1) sounds, as the old bar's gain
to piano_volume(hard)
  return 0.06 + 0.94 * hard ^ 1.8

# one key sounds (and lights)
let piano_last = ""      # the last note played, like "C4" (for tests and the curious)
to piano_sound(i, hard, length)
  piano_last = piano_note_name(i + 21)
  note "keys", piano_last, volume: piano_volume(hard), length: length
  light_key(i)

# ---- the tap
to piano_seated()
  return player_sitting() and my_seat >= 0 and seats[my_seat].kind == "piano-bench"

to piano_tap(e)
  if not e.hit
    return no
  # the sheet music: tap to pick a song, tap again to stop it
  if e.distance <= piano_sheet_reach and e.name == "piano"
    let l = piano_to_local(e.at)
    let m = 0.05
    if l.x > sheet_low.x - m and l.x < sheet_high.x + m and l.y > sheet_low.y - m and l.y < sheet_high.y + m and l.z > sheet_low.z - m and l.z < sheet_high.z + m
      piano_sheet()
      return yes
  # the keys: only while sitting on the bench (the old rule); standing, the tap sits you down
  if e.distance <= piano_reach and e.name == "piano" and piano_seated()
    let found = piano_key_at(piano_to_local(e.at))
    if found != nothing
      piano_sound(found.key, found.hard, 1.2)
      return yes
  return no

tap_first.push(piano_tap)

# ---- the songs: [{title, bpm, notes}], notes written as "start,key,length,loudness;" with start
# and length in hundredths of a second, key a MIDI number and loudness 0..127
let piano_songs = [
  # Fur Elise - Beethoven (the Mutopia Project edition by Stelios Samelis, public domain; 01-fur-elise.mid in the old bar)
