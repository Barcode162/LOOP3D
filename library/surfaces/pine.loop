# pine · pale pine, sawn along the trunk, sanded and waxed: straight pale grain, small dark knots, a soft sheen
# For furniture, floors, shelves and beams where oak is too dark. Wears paler and smoother on edges; gathers dark in joints.
#
# kind: surface
# place: test_ball("pine", AT)
# tags: wood, pale, warm, indoor
# size: chair
# seeds: 1 to 4
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: asset pack, Fluff (2026-11-17)

ring = 4 mm        # a growth ring of plain-sawn pine: 3 to 5 mm
pore = 0.3 mm      # an open pore: 0.3 mm wide, 2 to 5 mm long
knot = 12 mm       # a small dark knot: 8 to 20 mm across

to pine(seed: 1)
  return surface("pine", seed: seed, tile: 2 m, project: "box", along: "long",
    base:   {color: rgb(0.78, 0.64, 0.44), color2: rgb(0.62, 0.48, 0.30), roughness: 0.6, roughness2: 0.65,
             pattern: "grain", size: ring, stretch: 40, bump: 0.12 mm},
    coat:   {color: rgb(0.35, 0.22, 0.12), roughness: 0.6, cover: 0.03, pattern: "speckle", size: knot,
             stretch: 1, sits: "any"},
    vary:   {large: 1 m, amount: 0.1, roughness: 0.04},
    wear:   {color: rgb(0.85, 0.73, 0.54), roughness: 0.45, amount: 0.8, ragged: 0.5},
    dirt:   {color: rgb(0.16, 0.11, 0.07), roughness: 0.85, amount: 0.6, ragged: 0.6},
    detail: {pattern: "pores", size: pore, stretch: 10, bump: 0.03 mm, tile: 8 cm})
