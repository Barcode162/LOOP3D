# slate · dark blue-grey slate in large flat tiles, 300 mm square, a 5 mm joint set back
# For floors, hearths, roofs and worktops. Each tile takes its own tone; edges wear paler; grime gathers in the joints.
#
# kind: surface
# place: test_ball("slate", AT)
# tags: stone, slate, dark, floor, outdoor, indoor
# size: room
# seeds: 1 to 4
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: asset pack, Fluff (2026-11-17)

let tile_size = 30 cm
let tile_side = 1.5 m    # holds five tiles across

to slate(seed: 1)
  return surface("slate", seed: seed, tile: tile_side, space: "world",
    base: {color: rgb(0.28, 0.30, 0.34), color2: rgb(0.18, 0.20, 0.24), roughness: 0.7, roughness2: 0.8,
           pattern: "tiles", size: tile_size, stretch: 1, piece: 0.1, bump: 1 mm},
    coat: {color: rgb(0.35, 0.38, 0.42), roughness: 0.6, cover: 0.25, facing: "any",
           pattern: "noise", size: 15 cm, sits: "any"},
    vary: {large: 1.5 m, amount: 0.1, tint: rgb(0.22, 0.24, 0.28)},
    wear: {color: rgb(0.42, 0.44, 0.48), roughness: 0.6, amount: 0.4},
    dirt: {color: rgb(0.10, 0.10, 0.11), roughness: 0.95, amount: 0.4},
    detail: {pattern: "speckle", size: 0.5 mm, bump: 0.1 mm})
