# bar_stool · a round wooden bar stool on a steel post, with a round base and a footrest
# bar_stool(at, turn) places one, seat 0.75 m high, and gives it back; sit_stool(stool)
# says where to sit. The seat is oak, the post and base are blackened steel.
#
# kind: model
# place: bar_stool(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: asset pack, Fluff (2026-11-17)
# tags: stool, seat, bar, wood, steel
# size: chair
# sockets: seat

let stool_wood = material(like: "oak", color: rgb(0.55, 0.42, 0.30), roughness: 0.55)
let stool_steel = material(color: rgb(0.04, 0.04, 0.04), metal: 1, roughness: 0.45)

to bar_stool(at: vec(0, 0, 0), turn: 0)
  let parts = []
  parts.push({shape: cylinder(0.19, 0.05, at: vec(0, 0, 0), material: stool_wood, collide: no), offset: vec(0, 0.75, 0)})
  parts.push({shape: cylinder(0.03, 0.68, at: vec(0, 0, 0), material: stool_steel, collide: no), offset: vec(0, 0.39, 0)})
  parts.push({shape: cylinder(0.20, 0.03, at: vec(0, 0, 0), material: stool_steel, collide: no), offset: vec(0, 0.015, 0)})
  parts.push({shape: cylinder(0.16, 0.02, at: vec(0, 0, 0), material: stool_steel, collide: no), offset: vec(0, 0.25, 0)})
  let stool = {parts: parts, at: at, turn: turn}
  move_stool(stool, at, turn: turn)
  return stool

to move_stool(stool, at, turn: 0)
  stool.at = at
  stool.turn = turn
  for each p in stool.parts
    let o = p.offset
    p.shape.position = at + vec(o.x * cos(turn) + o.z * sin(turn), o.y, o.z * cos(turn) - o.x * sin(turn))
    p.shape.turn = turn

to sit_stool(stool)
  return stool.at + vec(0, 0.78, 0)
