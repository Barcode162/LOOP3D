# laundry_basket · a tall woven laundry basket with a lid, a shirt sleeve caught under it
# laundry_basket(at) stands it on `at`: 0.4 m across, 0.6 m tall.
#
# kind: model
# place: laundry_basket(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: laundry, basket, hamper, bedroom, bathroom, loft
# size: chair
# seeds: none, the same every time
to laundry_basket(at: vec(0, 0, 0))
  let weave = material(color: rgb(0.62, 0.55, 0.42), roughness: 0.95)
  let g = group(at: at)
    lathe(profile: [vec(0, 0), vec(0.17, 0), vec(0.2, 0.58), vec(0, 0.58)], segments: 28, material: weave)
    for each i in range(1, 6, 1)
      ring(radius: 0.17 + 0.03 * i / 6, thickness: 0.005, at: vec(0, 0.58 * i / 6, 0), material: weave, sides: 28)
    lathe(profile: [vec(0, 0.62), vec(0.15, 0.615), vec(0.21, 0.585), vec(0.21, 0.575), vec(0, 0.575)], segments: 28, material: weave, collide: no)
    box size: vec(0.08, 0.2, 0.01), at: vec(0.12, 0.48, -0.16), turn: -30 deg, material: material(like: "fabric", color: rgb(0.3, 0.4, 0.55)), round: 0.004, collide: no
  return g
