# cat · a cat, still: sitting up with its tail round its feet, or curled up asleep
# cat(at, turn, pose, coat) puts it on `at`, its face towards -z: `pose` "sitting" (0.3 m tall) or "lying" (curled, 0.45 m
# long). `coat` is its colour. (Walking waits for its skeleton and clips.)
#
# kind: model
# place: cat(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: cat, pet, animal, life, loft
# size: hand
# seeds: none, the same every time
to cat(at: vec(0, 0, 0), turn: 0, pose: "sitting", coat: rgb(0.12, 0.1, 0.09))
  let fur = material(like: "wool", color: coat, roughness: 0.9, sheen: 0.7)
  let eye = material(color: rgb(0.6, 0.55, 0.1), roughness: 0.1, clearcoat: 1)
  let g = group(at: at, turn: turn)
    if pose == "sitting"
      sphere(radius: 0.1, at: vec(0, 0.1, 0.04), scale: vec(1, 1.05, 1.15), material: fur, sides: 16, collide: no)
      sphere(radius: 0.075, at: vec(0, 0.2, -0.01), scale: vec(0.95, 1.2, 1), material: fur, sides: 16, collide: no)
      sphere(radius: 0.058, at: vec(0, 0.3, -0.04), scale: vec(1.05, 0.95, 1), material: fur, sides: 16, collide: no)
      for each s in [-1, 1]
        cone(radius: 0.022, height: 0.045, at: vec(s * 0.033, 0.355, -0.035), rotation: vec(0, 0, s * -0.25), material: fur, sides: 8, collide: no)
        sphere(radius: 0.009, at: vec(s * 0.022, 0.31, -0.092), material: eye, sides: 8, collide: no)
        capsule(radius: 0.018, height: 0.12, at: vec(s * 0.03, 0.06, -0.06), material: fur, sides: 8, collide: no)
      ring(radius: 0.1, thickness: 0.016, at: vec(0.02, 0.016, 0.02), scale: vec(1.1, 1, 0.9), material: fur, sides: 16)
    else
      sphere(radius: 0.15, at: vec(0, 0.07, 0), scale: vec(1.35, 0.5, 1), material: fur, sides: 16, collide: no)
      sphere(radius: 0.058, at: vec(-0.13, 0.08, -0.07), scale: vec(1, 0.8, 1), material: fur, sides: 14, collide: no)
      for each s in [-1, 1]
        cone(radius: 0.02, height: 0.04, at: vec(-0.13 + s * 0.03, 0.135, -0.07), rotation: vec(0, 0, s * -0.3), material: fur, sides: 8, collide: no)
      ring(radius: 0.16, thickness: 0.018, at: vec(0, 0.02, 0), scale: vec(1.3, 1, 1), material: fur, sides: 16)
  return g
