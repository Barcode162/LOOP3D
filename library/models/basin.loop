# basin · a round white basin on a floating oak shelf, a tall brass tap
# basin(at, turn) fixes it with `at` the middle of the shelf's back on the wall, the shelf top 0.82 m up, facing -z:
# the shelf 0.7 x 0.45 m.
#
# kind: model
# place: basin(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: basin, sink, washbasin, tap, bathroom, loft
# size: chair
# seeds: none, the same every time
to basin(at: vec(0, 0, 0), turn: 0)
  let g = group(at: at, turn: turn)
    box size: vec(0.7, 0.05, 0.45), at: vec(0, 0.795, -0.225), material: "oak", round: 0.006
    lathe(profile: [vec(0, 0.82), vec(0.16, 0.82), vec(0.2, 0.95), vec(0.19, 0.95), vec(0.15, 0.835), vec(0, 0.835)], segments: 40, at: vec(0, 0, -0.24), material: "porcelain", collide: no)
    cylinder(radius: 0.012, height: 0.25, at: vec(0, 0.945, -0.04), material: "brass", sides: 14, collide: no)
    box size: vec(0.018, 0.018, 0.16), at: vec(0, 1.06, -0.11), material: "brass", collide: no
    box size: vec(0.012, 0.04, 0.012), at: vec(0.04, 1.08, -0.04), material: "brass", collide: no
  return g
