# tv · a thin flat television on a small foot, off (a black glass face) or on (a dim glow)
# tv(at, turn, size, on) stands it on `at`, its screen towards -z: `size` the diagonal in inches (55).
#
# kind: model
# place: tv(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: tv, television, screen, living, loft
# size: chair
# seeds: none, the same every time
to tv(at: vec(0, 0, 0), turn: 0, size: 55, on: no)
  let w = size * 0.0254 * 0.872
  let h = size * 0.0254 * 0.49
  let face = material(color: rgb(0.01, 0.01, 0.012), roughness: 0.06)
  if on
    face = material(color: rgb(0.01, 0.01, 0.012), roughness: 0.06, glow: rgb(0.35, 0.45, 0.6) * 6)
  let g = group(at: at, turn: turn)
    box size: vec(0.3, 0.012, 0.2), at: vec(0, 0.006, 0), material: "black", round: 0.004
    box size: vec(0.06, 0.08, 0.03), at: vec(0, 0.05, 0.02), material: "black", collide: no
    box size: vec(w, h, 0.03), at: vec(0, 0.08 + h / 2, 0.02), material: "black", round: 0.004
    box size: vec(w - 0.01, h - 0.01, 0.002), at: vec(0, 0.08 + h / 2, 0.004), material: face, collide: no
  return g
