# shoe_rack · a two-tier oak shoe rack with shoes and boots on it
# shoe_rack(at, turn, length) stands it on `at`, its front towards -z: `length` (0.8 m), 0.3 m deep, 0.45 m tall.
#
# kind: model
# place: shoe_rack(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: shoe rack, shoes, boots, entry, hall, loft
# size: chair
# seeds: none, the same every time
to shoe_rack(at: vec(0, 0, 0), turn: 0, length: 0.8)
  let leather = material(like: "leather", color: rgb(0.25, 0.14, 0.08))
  let canvas = material(like: "fabric", color: rgb(0.85, 0.85, 0.82))
  let g = group(at: at, turn: turn)
    for each s in [-1, 1]
      box size: vec(0.025, 0.45, 0.3), at: vec(s * (length / 2 - 0.0125), 0.225, 0), material: "oak", collide: no
    for each y in [0.08, 0.3]
      for each z in [-0.09, 0.09]
        box size: vec(length - 0.05, 0.02, 0.025), at: vec(0, y, z), material: "oak", collide: no
    for each i in range(0, 3, 1)
      let x = -length / 2 + 0.15 + i * 0.25
      for each s in [-1, 1]
        box size: vec(0.085, 0.07, 0.26), at: vec(x + s * 0.048, 0.125, 0), material: (leather if i != 1 else canvas), round: 0.03, steps: 2, collide: no
    box size: vec(0.09, 0.32, 0.12), at: vec(-length / 2 + 0.17, 0.47, 0.06), material: leather, round: 0.03, collide: no
    box size: vec(0.09, 0.32, 0.12), at: vec(-length / 2 + 0.27, 0.47, 0.06), material: leather, round: 0.03, collide: no
    box size: vec(0.09, 0.08, 0.27), at: vec(-length / 2 + 0.17, 0.35, -0.01), material: leather, round: 0.03, collide: no
    box size: vec(0.09, 0.08, 0.27), at: vec(-length / 2 + 0.27, 0.35, -0.01), material: leather, round: 0.03, collide: no
  return g
