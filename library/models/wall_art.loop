# wall_art · a stretched canvas of our own abstract painting: soft fields of colour, a few marks, a different picture for every seed
# wall_art(at, turn, width, height, seed, palette) hangs it with `at` its middle on the wall, facing -z: `width` (0.8 m)
# by `height` (1.0 m), 4 cm deep. `palette` "warm" (ochre, rust, cream), "cool" (slate, sea, sand) or "night" (ink, gold).
#
# kind: model
# place: wall_art(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: art, painting, canvas, picture, wall, living, bedroom, loft
# size: chair
# seeds: any whole number (each its own painting)
let art_palettes = {warm: [rgb(0.85, 0.78, 0.62), rgb(0.72, 0.42, 0.16), rgb(0.48, 0.18, 0.1), rgb(0.15, 0.12, 0.1)], cool: [rgb(0.8, 0.8, 0.76), rgb(0.3, 0.42, 0.5), rgb(0.62, 0.55, 0.42), rgb(0.1, 0.13, 0.16)], night: [rgb(0.06, 0.07, 0.1), rgb(0.16, 0.2, 0.3), rgb(0.78, 0.6, 0.22), rgb(0.86, 0.82, 0.72)]}

to wall_art(at: vec(0, 0, 0), turn: 0, width: 0.8, height: 1.0, seed: 1, palette: "warm")
  let p = art_palettes[palette]
  let paint = [material(color: p[0], roughness: 0.85), material(color: p[1], roughness: 0.8), material(color: p[2], roughness: 0.8), material(color: p[3], roughness: 0.75)]
  let g = group(at: at, turn: turn)
    box size: vec(width, height, 0.04), at: vec(0, 0, -0.02), material: paint[0], round: 0.003
    # two fields of colour, a band, a disc and a thin line, each placed by the seed
    let fy = noise(seed, 0.3, 0.1) * 0.25 * height
    box size: vec(width - 0.08, height * 0.45, 0.002), at: vec(0, fy - height * 0.2, -0.041), material: paint[1], collide: no
    box size: vec(width * (0.35 + noise(seed, 1.3, 0.2) * 0.15), height * 0.3, 0.002), at: vec(noise(seed, 2.1, 0.3) * width * 0.2, fy + height * 0.2, -0.0415), material: paint[2], collide: no
    cylinder(radius: width * (0.12 + noise(seed, 3.7, 0.4) * 0.05), height: 0.002, at: vec(noise(seed, 4.4, 0.5) * width * 0.3, height * 0.25, -0.042), rotation: vec(0, 90 deg, 0), material: paint[3], sides: 40, collide: no)
    box size: vec(width * 0.6, 0.006, 0.002), at: vec(noise(seed, 5.2, 0.1) * width * 0.15, fy - height * 0.02, -0.0425), turn: 0, material: paint[3], collide: no
  return g
