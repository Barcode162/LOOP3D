# knife_block · a slanted oak knife block with five black knife handles standing in it
# knife_block(at, turn) stands it on `at`, leaning back towards +z: 0.12 m wide, 0.24 m tall.
#
# kind: model
# place: knife_block(AT)
# credit: J Production, made in Loop3D
# licence: our own work, free for every J Production project
# from: The Loft (2026-11-18)
# tags: knives, knife block, kitchen, counter, loft
# size: hand
# seeds: none, the same every time
to knife_block(at: vec(0, 0, 0), turn: 0)
  let g = group(at: at, turn: turn)
    box size: vec(0.12, 0.2, 0.09), at: vec(0, 0.095, 0.02), tilt: -18 deg, material: "oak", round: 0.008, steps: 2, collide: no
    for each i in range(0, 5, 1)
      let x = -0.04 + (i % 3) * 0.04
      let z = 0.02 + floor(i / 3) * 0.03
      box size: vec(0.018, 0.11 - i * 0.008, 0.024), at: vec(x, 0.235 - i * 0.004, z + 0.05), tilt: -18 deg, material: "black", round: 0.008, collide: no
  return g
