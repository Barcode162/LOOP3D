# 9. The Cistern Brotherhood — PLAYED. Underground.
use "ardane_common"
title "9 · The Cistern Brotherhood"
mode "game"

let rock_wall = material(like: "stone", color: rgb(0.45, 0.32, 0.24), pattern_scale: 2, bump: 3 mm)
ground 60, material: material(like: "stone", color: rgb(0.35, 0.27, 0.2))
# a long vaulted tunnel opening into a cistern hall
for z from 4 to -26 by -2
  box size: vec(0.8, 4, 2.1), at: vec(-3, 2, z), material: rock_wall
  box size: vec(0.8, 4, 2.1), at: vec(3, 2, z), material: rock_wall
  box size: vec(6.8, 0.8, 2.1), at: vec(0, 4.2, z), material: rock_wall
box size: vec(16, 6, 1), at: vec(0, 3, -27), material: rock_wall
box size: vec(4, 0.2, 18), at: vec(0, 0.02, -14), material: "water", collide: no
# one shaft of daylight far above
panel_light at: vec(0, 4.5, -18), facing: vec(0, -1, 0), size: vec(1, 1), lumens: 6000, kelvin: 6000
fog 0.08, glow: 0.7, from: vec(-3, 0, -28), to: vec(3, 5, 6)
for z from 2 to -24 by -6.5
  lantern vec(-2.4, 2.2, z), lumens: 90
  lantern vec(2.4, 2.2, z - 3), lumens: 90

let hesk = someone(vec(0, 0, -20), height: 1.7, shirt: cloth(0.25, 0.2, 0.18), skin: skin_deep, facing: 0 deg)
let brotherhood = []
for each p in [vec(-1.8, 0, -17), vec(1.8, 0, -17.5), vec(-1.5, 0, -21.5), vec(1.6, 0, -22), vec(-2, 0, -13), vec(2, 0, -14)]
  let b = someone(p, shirt: cloth(0.3, 0.25, 0.2), skin: skin_deep)
  b.look_at = vec(0, 1.5, -10)
  brotherhood.push(b)

sound "stream", volume: 0.3
room 0.8, echo: 0.45
sky "none"
look "noir", contrast: 1.2, grain: 0.05, bars: 2.39
look "golden", contrast: 1.2, warmth: 0.2, grain: 0.04, vignette: 0.6, bars: 2.39
camera at: vec(0, 1.6, 3), look_at: vec(0, 1.3, -10), lens: 28 mm
render file: "ardane_09_cisterns.png", quality: "good", width: 1280, at: 3 s

task
  wait 1 s
  say "", "Oren looks the other way. Milo slips down the servants' well, into the dark under the city."
  go_to_place(vec(0, 0, -14), "Follow the tunnel toward the light.")
  for each b in brotherhood
    b.walk_to = player() + vec(random(-1.5, 1.5), 0, random(-1.5, 1.5))
    b.look_at = player() + vec(0, 1.4, 0)
  hesk.walk_to = player() + vec(0, 0, -1.6)
  wait 2 s
  say "Hesk", "A palace boy. In our tunnels."
  say "Hesk", "Give me one reason not to drown you in our water."
  let c = choose("They're closing in.", ["Hum Nana's well-song", "Tell them about the fountain"])
  if c == 1
    say "Milo", "I fixed their fountain. I know how water moves."
    say "Hesk", "Then you know how it drowns. Try again."
  say "", "He doesn't know why. He hums the song his grandmother sings over her red thread."
  sound "bell", "glass", at: player(), strength: 0.2
  wait 2 s
  say "", "The tunnels go silent. Someone sets down a knife."
  say "Hesk", "...That's Tobiah's song. The well-digger's song."
  say "Hesk", "They cut his name off every wall in this city. Who taught you that?"
  say "Milo", "My grandmother."
  say "Hesk", "Then you're one of us."
  say "Hesk", "Under the city, child, under the palace, is the Deep Well. Tobiah Ardane found it and gave it to everyone. The Sunborn sealed it with stone."
  say "Hesk", "Open it."
  next_scene "ardane_10_well", delay: 1.5 s
