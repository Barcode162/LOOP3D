# 7. The Red City — WATCHED. White noon.
use "ardane_common"
title "7 · Qadesh, the Red City"
mode "movie"

ground 200, material: "sand"
qadesh_houses(vec(0, 0, -20), count: 40, spread: 50)
# the alley is a crack between two sandstone cliffs
box size: vec(6, 14, 24), at: vec(-5, 7, -8), material: sandstone
box size: vec(6, 12, 24), at: vec(5, 6, -8), material: sandstone
let ring_glow = portal(vec(0, 1.6, -12), size: 1.2, color: rgb(1.0, 0.8, 0.5))
palm(vec(-3, 0, 8))
palm(vec(4, 0, 10))

let milo = hero(vec(0, 0, -11), facing: 0 deg)
let nia = someone(vec(0.6, 0, -11.5), height: 1.62, shirt: cloth(0.55, 0.18, 0.15), skin: skin_deep)
let oren = someone(vec(0, 0, 6), height: 1.92, shirt: cloth(0.85, 0.7, 0.3), trousers: linen, skin: skin_deep, facing: 180 deg)
let spear = cylinder(0.025, 2.2, at: vec(0.4, 1.2, 6), material: "bronze", collide: no)

sound "wind", volume: 0.7
sound "bell", "metal", at: vec(-30, 10, -60), strength: 0.3
room 0
sky "physical", haze: 3
sun elevation: 72 deg, toward: 180 deg, lux: 120000
look "western", bars: 2.39

camera at: vec(0, 1.6, 4), look_at: vec(0, 1.5, -10), lens: 28 mm
shot "the canyon", 6 s, from: {at: vec(0, 9, 14), look_at: vec(0, 1, -12), lens: 24 mm, f_stop: 8}, to: {at: vec(0, 4, 9), look_at: vec(0, 1, -10), lens: 28 mm}, fade_in: 1.5 s
shot "out of the light", 6 s, from: {at: vec(1.2, 1.4, -5), look_at: vec(0, 1.3, -11), lens: 50 mm, f_stop: 2.8}, to: {at: vec(1, 1.4, -6), look_at: vec(0, 1.3, -9), lens: 50 mm}
shot "the guard", 10 s, from: {at: vec(-1.5, 1.2, -4), look_at: vec(0, 1.6, 4), lens: 35 mm, f_stop: 4}, to: {at: vec(-1.2, 1.0, -3), look_at: vec(0, 1.8, 2.5), lens: 40 mm}, fade_out: 1.5 s
render file: "ardane_07_qadesh.png", quality: "good", width: 1280, at: 4 s

task
  wait 4 s
  milo.walk_to = vec(0, 0, -3)
  nia.walk_to = vec(0.8, 0, -3.4)
  say "", "Heat. Red stone. A sky so white it hurts."
  oren.walk_to = vec(0, 0, 1.5)
  every 1 / 30 s
    spear.position = oren.position + vec(0.4, 1.2, 0)
  wait 3 s
  say "Oren", "Water-thieves. On your knees."
  nia.look_at = oren.position + vec(0, 1.7, 0)
  say "Nia", "Do we LOOK like we've had any water?"
  say "Oren", "...No. You do not. That is why I am arresting you and not killing you."
  next_scene "ardane_08_palace", delay: 1.5 s
