# 17. A Stranger at Home — PLAYED. The room above the laundry. Evening, rain.
use "ardane_common"
title "17 · A Stranger at Home"
mode "game"

home_room(daylight: 300, daylight_temp: 9000)
let fam = the_family()
let nana = fam.nana
let rosa = fam.rosa
let bea = fam.bea
nana.look_at = vec(-1.1, 1.5, 2.2)
rosa.look_at = vec(-1.4, 0.8, -1.4)
# Bea, hiding behind the end of Nana's bed
bea.position = vec(2.6, 0, 1.9)
bea.facing = 230 deg
# the open door: it slams at the end
let door = box(size: vec(1.0, 2.2, 0.06), at: vec(-1.1 + 0.48, 1.1, 2.6 - 0.48), turn: 90 deg, material: "old wood", collide: no)
# the gold he brings: a sack on the table, spilling
let gold_at = vec(-1.4, 0.77, -1.3)
for i from 0 to 11
  sphere 0.035, at: gold_at + vec(random(-0.2, 0.2), 0.0, random(-0.15, 0.15)), scale: vec(1, 0.3, 1), material: "gold", collide: no
sphere 0.14, at: gold_at + vec(0.15, 0.1, 0), scale: vec(1, 0.8, 1), material: material(like: "fabric", color: rgb(0.5, 0.35, 0.2)), collide: no
sound "rain", volume: 0.8
room 0.2, echo: 0.1
sky "physical", haze: 10
sun elevation: -4 deg, toward: 95 deg, lux: 30
look "noir", contrast: 1.1, saturation: 0.6, grain: 0.04, bars: 2.39
camera at: vec(-1.1, 1.6, 2.1), look_at: vec(1.0, 1.0, 0), lens: 28 mm, f_stop: 2.8
relic_orbit(nothing, recall("relics", 5), radius: 0.6)
render file: "ardane_17_return.png", quality: "good", width: 1280, at: 6 s

task
  wait 1.5 s
  say "", "Home. The same rain. The room is smaller than he remembered."
  say "", "Five lights circle him. They hum. Nobody in the room says anything."
  go_and_use(vec(-1.4, 0, -0.8), "Put the Qadesh gold on the table.")
  sound "impact", "metal", at: gold_at, strength: 0.4
  say "Milo", "It's gold, Mum. Real gold. It's enough for the rent. For a year of rent."
  rosa.look_at = player() + vec(0, 1.5, 0)
  say "Rosa", "Where did you get it?"
  say "Milo", "Does it matter?"
  say "Rosa", "It does to me."
  rosa.look_at = vec(-1.4, 0.8, -1.4)
  say "", "She doesn't touch it."
  go_and_use(vec(2.0, 0, 1.5), "Bea is behind Nana's bed.")
  bea.look_at = player() + vec(0, 1.5, 0)
  bea.walk_to = vec(2.8, 0, 2.3)
  say "", "Bea looks up at him and backs away. She doesn't know who he is."
  say "Milo", "Bea. It's me. It's your giant."
  say "", "She hides her face in Nana's blanket."
  rosa.sitting = no
  rosa.walk_to = player() + vec(-0.8, 0, -0.6)
  wait 2 s
  rosa.look_at = player() + vec(0, 1.5, 0)
  say "Rosa", "You've come home a stranger wearing my son's jacket."
  say "Milo", "I can fix everything now. Don't you see? I can make the Varens kneel."
  say "Rosa", "I never wanted anyone to kneel, Milo. I wanted you home for supper."
  say "", "From the bed by the window, Nana speaks, very softly."
  say "Nana", "Little lamp."
  say "Nana", "Who are you fighting for?"
  pause 3 s
  say "", "He opens his mouth. Nothing comes."
  go_and_use(vec(-1.1, 0, 2.2), "Leave.")
  door.position = vec(-1.1, 1.1, 2.6)
  door.turn = 0 deg
  sound "thud", "wood", at: vec(-1.1, 1.1, 2.6), strength: 1
  say "", "The door slams. On his wrist, the red thread pulls tight."
  next_scene "ardane_18_hollow", delay: 2 s
