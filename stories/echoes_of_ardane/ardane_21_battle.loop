# 21. The Last Battle — WATCHED. The street, the sky and the islands, all at once. Storm.
use "ardane_common"
title "21 · The Last Battle"
mode "movie"

calder_row()
let flood = box(size: vec(10, 0.2, 80), at: vec(0, -0.2, -10), material: "water", collide: no)
sky_island vec(-8, 18, -14), radius: 7, depth: 8, trees: 4, pattern: 211
# Sela's roots: they come down from the island to the street
let roots = []
for i from 0 to 4
  roots.push(root(vec(-8 + i * 0.8, 10, -14 + i * 0.5), vec(-0.5 + i * 0.3, 0.2, -14 + i * 0.6), sag: -2, alive: no, thick: 0.22))
for each r in roots
  for each part in r
    part.visible = no
# Nia's boat, on the flooded street
let boat = raft(vec(-2.5, 0, -6), size: vec(1.4, 0.3, 3.2), turn: 10 deg)
let lightning = light(vec(0, 40, -20), lumens: 0, kelvin: 8000, radius: 4)
rain_streaks vec(0, 0, -10), count: 260, spread: 5, height: 10

let milo = hero(vec(0, 0, -6), facing: 180 deg)
let nia = nia_at(vec(-2.5, 0, -6), facing: 160 deg)
let oren = oren_at(vec(1.0, 0, -7), facing: 180 deg)
let sela = sela_at(vec(-1.6, 0, -2), facing: 200 deg)
let veyl = veyl_at(vec(0, 1.0, -10.5), facing: 0 deg)
veyl.look_at = vec(0, 1.4, -6)
let robot = pip(vec(6, 0, -10), facing: 270 deg)
for each part in [robot.body, robot.head, robot.lens]
  part.visible = no
# the relics: all five, wide around him
let orbs = relic_orbit(milo, 5, radius: 1.4, height: 1.3)
# Veyl's strike: a bar of black-gold light
let strike = box(size: vec(0.15, 0.15, 6), at: vec(0, 1.4, -10), material: material(color: rgb(0, 0, 0), glow: rgb(1, 0.65, 0.2) * 3000), collide: no)
strike.visible = no

sound "rain", volume: 1
sound "wind", volume: 0.9
let hum = sound("hum", at: vec(0, 1, -6), volume: 1.4)
sound "heartbeat", volume: 0.5
room 0.5, echo: 0.4
sky "physical", haze: 12, stars: 0
sun elevation: -8 deg, lux: 0.3
fog 0.03, glow: 0.7, color: rgb(0.8, 0.8, 0.9)
look "blockbuster", contrast: 1.25, bloom: 0.4, grain: 0.04, bars: 2.39

camera at: vec(4, 2, 0), look_at: vec(0, 1.4, -8), lens: 24 mm
orbit "five lights", 18 s, around: vec(0, 0, -6), radius: 4.5, height: 1.8, from: 60 deg, to: 160 deg, lens: 24 mm, shake: 0.4, fade_in: 1 s
shot "boat and roots", 18 s, from: {at: vec(-5, 1, 0), look_at: vec(-2.5, 1, -6), lens: 28 mm}, to: {at: vec(-4, 5, -2), look_at: vec(-1, 6, -14), lens: 20 mm}, shake: 0.6
shot "the shield", 14 s, from: {at: vec(2.5, 1.2, -4), look_at: vec(0.5, 1.6, -9), lens: 35 mm}, to: {at: vec(1.6, 1.4, -6), look_at: vec(0.5, 1.6, -9), lens: 50 mm}, shake: 0.9
shot "Pip", 18 s, from: {at: vec(4, 0.5, -6), look_at: vec(2.5, 0.4, -9), lens: 50 mm, f_stop: 1.8}, to: {at: vec(3.4, 0.4, -7.2), look_at: vec(2.4, 0.3, -9), lens: 65 mm, f_stop: 1.8}
shot "one knee", 15 s, from: {at: vec(2.0, 0.45, -3.6), look_at: vec(0, 1.5, -10), lens: 24 mm, f_stop: 4}, to: {at: vec(1.6, 0.5, -4.0), look_at: vec(0, 1.8, -11), lens: 28 mm, f_stop: 4}, shake: 0.3
shot "the rain stops", 15 s, from: {at: vec(0.7, 1.0, -8.0), look_at: vec(0, 0.95, -6), lens: 50 mm, f_stop: 1.8}, to: {at: vec(0.12, 0.98, -6.75), look_at: vec(0, 0.95, -6), lens: 85 mm, f_stop: 1.4}, ease: "in", fade_out: 3 s
render file: "ardane_21_battle.png", quality: "good", width: 1280, at: 80 s

to flash()
  lightning.lumens = 3000000
  sound "thud", "stone", at: vec(0, 30, -20), strength: 1
  after 0.12 s
    lightning.lumens = 0

task
  every 7 s
    flash()
  wait 1.5 s
  say "", "He calls them, and they come. All five."
  say "", "The street floods ankle-deep and stills. A well opens in the asphalt. Roots split the kerb. Time stutters, like a skipped heartbeat."
  every 1 / 30 s
    if flood.position.y < 0.15
      flood.position = vec(0, flood.position.y + 0.004, -10)
  say "", "For a moment, he is a god."
  wait 2 s
  # the friends
  nia.lift = 0.15
  say "Nia", "Left! He's going left!"
  for each r in roots
    for each part in r
      part.visible = yes
  sound "whoosh", "wood", at: vec(-3, 5, -14)
  say "Sela", "Hold him!"
  say "", "Sela brings down an island's roots. They wrap Veyl like a hand closing."
  wait 3 s
  strike.visible = yes
  sound "impact", "metal", at: vec(0.6, 1.4, -8), strength: 1
  oren.walk_to = vec(1.5, 0, -8.6)
  say "", "Veyl's strike comes like a falling bar of the sun. Oren steps into it."
  say "Oren", "Guard the right thing, boy!"
  say "", "It takes him on the sword arm. He goes down and doesn't get up."
  strike.visible = no
  oren.sitting = yes
  wait 2 s
  # Pip comes back
  for each part in [robot.body, robot.head, robot.lens]
    part.visible = yes
  let start = time()
  every 1 / 30 s
    let u = clamp((time() - start) / 3, 0, 1)
    pip_move(robot, lerp(vec(6, 0, -10), vec(2.4, 0, -9), ease(u, "out")), facing: 270 deg)
  say "Pip", "ERROR. ERROR. I have come back. I was told I was an it. I have decided I am not."
  wait 1 s
  strike.position = vec(1.2, 0.5, -10)
  strike.visible = yes
  sound "impact", "metal", at: vec(2.4, 0.4, -9), strength: 1
  say "", "Veyl's second strike was meant for Milo. Pip rolls in front of it."
  strike.visible = no
  pip_dark(robot)
  say "", "His lens goes dark."
  pause 2 s
  say "Milo", "Pip. Pip!"
  # Veyl is stronger
  milo.sitting = yes
  for each o in orbs
    o.glow.lumens = 30
  for each r in roots
    for each part in r
      part.visible = no
  sound "impact", "wood", at: vec(0, 1, -10.5), strength: 1
  say "", "Veyl tears free of the roots. A thousand years of practice. Milo goes down on one knee. The lights around him flicker."
  say "Veyl", "You see? You can't keep anything. Nobody can. So I keep everything."
  pause 2 s
  say "", "Milo closes his eyes."
  say "", "The Mercy Shard slows time. And slows it. And slows it."
  rain_frozen = yes
  hum.volume = 0.2
  say "", "Until the raindrops stop, a hand's breadth from his face."
  next_scene "ardane_22_mind", delay: 3 s
