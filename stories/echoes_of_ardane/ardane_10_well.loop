# 10. The Deep Well — WATCHED. A sandstorm at dusk; then the deep.
use "ardane_common"
title "10 · The Deep Well"
mode "movie"

let rock_wall = material(like: "stone", color: rgb(0.45, 0.32, 0.24), bump: 3 mm)
ground 60, material: material(like: "stone", color: rgb(0.3, 0.24, 0.18))
# a round shaft going down into the dark
for i from 0 to 15
  let a = i * tau / 16
  box size: vec(1.0, 20, 0.6), at: vec(cos(a) * 3, 6, sin(a) * 3), turn: -a + 90 deg, material: rock_wall
# the door: a man holding a cup out, carved
let door = box(size: vec(1.6, 2.4, 0.3), at: vec(0, 1.2, -2.6), material: sandstone)
box size: vec(0.4, 0.6, 0.05), at: vec(0, 1.6, -2.42), material: "bronze", collide: no
let key_glow = light(vec(0, 1.3, -2.3), lumens: 0, color: rgb(1, 0.75, 0.3), radius: 0.06)
let key = sphere(0.06, at: vec(0, 1.3, -2.35), material: material(color: rgb(0, 0, 0), glow: rgb(1, 0.75, 0.3) * 4000), collide: no)
key.visible = no
let water = box(size: vec(5.6, 0.2, 5.6), at: vec(0, -2, 0), material: "water", collide: no)
let storm_light = panel_light(at: vec(0, 15.5, 0), facing: vec(0, -1, 0), size: vec(4, 4), lumens: 30000, kelvin: 2400)
fog 0.06, glow: 0.8, color: rgb(1, 0.8, 0.6), from: vec(-3, 0, -3), to: vec(3, 16, 3)

let milo = hero(vec(0, 0, 0.5), facing: 180 deg)
let oren = someone(vec(1.4, 0, 1.4), height: 1.92, shirt: cloth(0.85, 0.7, 0.3), trousers: linen, skin: skin_deep)
oren.visible = no

sound "wind", volume: 0.9
sound "stream", volume: 0
room 0.9, echo: 0.6
sky "none"
look "golden", contrast: 1.15, grain: 0.04, bars: 2.39
camera at: vec(1.5, 1.6, 2), look_at: vec(0, 1.2, -2.6), lens: 28 mm
shot "the descent", 7 s, from: {at: vec(0, 14, 0.3), look_at: vec(0, 0, 0), lens: 24 mm, f_stop: 5.6}, to: {at: vec(0, 5, 0.5), look_at: vec(0, 0, 0), lens: 24 mm}, ease: "in_out", fade_in: 1.5 s
shot "the door", 9 s, from: {at: vec(1.6, 1.5, 1.6), look_at: vec(0, 1.3, -2.6), lens: 35 mm, f_stop: 2.8}, to: {at: vec(0.8, 1.4, 0.8), look_at: vec(0, 1.4, -2.6), lens: 45 mm, f_stop: 2.8}
shot "the water", 9 s, from: {at: vec(2, 0.6, 2), look_at: vec(0, 1.5, 0), lens: 24 mm}, to: {at: vec(0.5, 6, 1), look_at: vec(0, 14, 0), lens: 20 mm}, ease: "in", fade_out: 2 s
render file: "ardane_10_well.png", quality: "good", width: 1280, at: 12 s

task
  wait 6 s
  say "", "Down past the city. Down past the light. The air goes cold and wet."
  milo.walk_to = vec(0, 0, -1.6)
  wait 2 s
  say "", "A stone door, carved with a man holding out a cup."
  say "", "He sings."
  sound "bell", "stone", at: vec(0, 1, -2.4), strength: 0.5
  wait 2 s
  door.position = vec(0, -1.3, -2.6)
  sound "thud", "stone", at: vec(0, 1, -2.4), strength: 1
  key.visible = yes
  key_glow.lumens = 300
  say "", "The door sinks into the floor. In its lock: a key of old brass. The Brass Key of Wells."
  remember "relics", 3
  every 1 / 30 s
    if water.position.y < 9
      water.position = vec(0, water.position.y + 0.06, 0)
  sound "stream", at: vec(0, 0, 0), volume: 1
  say "", "Water rises behind it, clear and cold, up the shaft, up into the storm."
  oren.visible = yes
  say "Oren", "I've guarded the wrong thing all my life."
  let c = choose("The Deep Well is open.", ["Give it to the Brotherhood to guard", "Give it to everyone"])
  remember "gave freely", c == 1
  if c == 1
    say "", "He opens it to the streets. In the storm, a hundred cups are raised. Hesk is furious, and then she isn't."
  else
    say "", "He gives it to the Brotherhood. They'll guard it. He hopes they'll share it."
  say "Nia", "...Milo. You told them what to do. Everyone just listened."
  say "Milo", "I know."
  say "", "He's smiling. She isn't."
  next_scene "ardane_11_aelor", delay: 2 s
